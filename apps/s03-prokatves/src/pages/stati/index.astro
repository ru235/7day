---
const SITE = 'https://prokatves.ru';
const title = 'Статьи о металлопрокате | prokatves.ru';
const desc = 'ВГП или э/с, арматура на фундамент, приёмка металла.';
const crumbs = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Главная', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Статьи', item: SITE + '/stati' }] });
const arts = [
  { s: 'vgp-vs-es', h: 'ВГП или электросварная', p: 'Ду, стенка, цена, применение.' },
  { s: 'armatura-fundament', h: 'Арматура на фундамент', p: 'Нитки, хомуты, нахлёсты, запас.' },
  { s: 'priemka-metalla', h: 'Приёмка металла', p: 'Весы, штангенциркуль, бирки, ржавчина.' },
];
---
<!doctype html><html lang="ru"><head><script is:inline src="/theme-head.js"></script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><meta name="description" content={desc} /><link rel="canonical" href={SITE + '/stati'} />
<meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:type" content="website" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="stylesheet" href="/_s555.css?v=1" /><script type="application/ld+json" set:html={crumbs}></script>
<!-- METRIKA: вставить код счётчика prokatves.ru -->
<script is:inline src="/theme.js" defer></script></head>
<body><div class="bg-field" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
<header class="site"><div class="wrap"><nav><a class="brand" href="/" aria-label="прокатвес — на главную"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 22 L16 7 L26 22 Z" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/><line x1="11" y1="22" x2="21" y2="22" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/></svg><span>прокатвес<small>.ru</small></span></a><button class="burger" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="Меню"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path class="l1" d="M2 5h16"/><path class="l2" d="M2 10h16"/><path class="l3" d="M2 15h16"/></svg></button><div class="nav-links" id="navlinks"><a href="/">Калькулятор</a><a href="/sortament">Сортамент</a><a href="/truby">Трубы</a><a href="/list">Лист</a><a href="/armatura">Арматура</a><a href="/primery">Примеры</a><button id="ttheme" class="tbtn" type="button" aria-label="Тёмная тема" title="Тёмная тема">◐</button></div></nav></div></header>
<main class="wrap"><nav class="crumbs" aria-label="Хлебные крошки"><a href="/">Главная</a> / <span aria-current="page">Статьи</span></nav>
<h1>Статьи о металлопрокате</h1>
<div class="cards">
{arts.map(a => (<a class="card" href={'/stati/' + a.s}><h3>{a.h}</h3><p>{a.p}</p></a>))}
</div>
<p><a href="/">← к калькулятору</a></p></main>
<footer class="site"><div class="wrap"><div class="fgrid"><div><h3>prokatves.ru</h3><p>Металлокалькулятор и сортамент. Теормасса по ГОСТ, факт ±3–5%. Обновлено 2026-09-09.</p></div><div><h3>Расчёты</h3><ul><li><a href="/">Калькулятор веса</a></li><li><a href="/sortament">Сортамент</a></li><li><a href="/truby">Трубы</a></li></ul></div><div><h3>Справочник</h3><ul><li><a href="/list">Лист</a></li><li><a href="/armatura">Арматура</a></li><li><a href="/primery">Примеры</a></li></ul></div></div></div></footer>
</body></html>
