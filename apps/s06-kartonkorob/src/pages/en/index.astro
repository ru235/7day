---
const SITE = 'https://formgen.ru';
const title = 'Corrugated box calculator: size, blank, strength | formgen.ru';
const desc = 'Size your box: FEFCO 0201 blank, board area, weight, stacking strength BCT. Flutes B/C/E/BC, grades.';
const faqs = [
  { q: 'How to size a 0201 blank?', a: 'Add the perimeter: 2×(length+width) plus a 20–40 mm glue flap. Sheet width is height plus box width. The calculator above is exact.' },
  { q: 'What is BCT?', a: 'Box compression strength in newtons (McKee). Divide by content weight with a factor of 3 — that is your stacking tiers.' },
  { q: 'Which flute to pick?', a: 'E — small retail boxes, B — die-cutting, C — shipping, BC — heavy loads and high stacks.' },
  { q: 'Grade T-23 or P-32?', a: 'T is 3-ply, P is 5-ply. P-32 holds far more but costs more. For stacks of 3+ tiers take 5-ply.' },
  { q: 'Can I order 50 boxes?', a: 'A cutting die costs money — small runs go on a plotter (more per box) or pick ready stock sizes.' },
  { q: 'Does moisture matter?', a: 'Yes: damp board loses up to 50% of strength. For unheated storage use moisture-resistant board.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const siteJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'formgen.ru', url: SITE, inLanguage: 'en' });
const pageJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE + '/en/', inLanguage: 'en', dateModified: '2026-09-15', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#tldr'] } });
const howtoJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'HowTo', name: 'How to size a 0201 box', inLanguage: 'en', step: [{ '@type': 'HowToStep', name: 'Measure the content', text: 'Length, width, height plus 10–20 mm spare.' }, { '@type': 'HowToStep', name: 'Pick the board', text: 'Flute and grade for weight and stacking.' }, { '@type': 'HowToStep', name: 'Get the blank', text: 'Sheet size, area, weight, BCT.' }] });
