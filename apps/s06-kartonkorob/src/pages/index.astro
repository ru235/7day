<script is:inline>
const $=id=>document.getElementById(id);
const NS='http://www.w3.org/2000/svg';
function el(n,at,parent){const e=document.createElementNS(NS,n);for(const k in at)e.setAttribute(k,at[k]);if(parent)parent.appendChild(e);return e}
const FLUTE={E:{t:1.6,g:500},B:{t:3.0,g:650},C:{t:4.0,g:750},BC:{t:7.0,g:1200}};
const TYPES={
 '0201':{name:'0201 — четырёхклапанная'},
 '0200':{name:'0200 — лоток', note:'Верх открыт, дно на скотч. Высота борта = H.'},
 '0202':{name:'0202 — клапаны внахлёст', note:'Наружные клапаны длиннее на 25 мм — прочнее стык.'},
 '0203':{name:'0203 — полное перекрытие', note:'Клапаны перекрывают всю ширину: максимум прочности, больше расход.'},
 '0301':{name:'0301 — телескоп', note:'Две детали (крышка + дно): только штамп или плоттер.'},
 '0427':{name:'0427 — архивная', note:'Оценка: точная развёртка — по штампу производителя.'},
 '0452':{name:'0452 — обёрточная', note:'Оценка: оборачивается вокруг товара, точная развёртка — по штампу.'},
 '0454':{name:'0454 — лоток с крышкой', note:'Оценка: точная развёртка — по штампу производителя.'},
 '0471':{name:'0471 — самосборная', note:'Дно-автомат: только штамп или плоттер. Площадь +15% на замки.'},
 '0701':{name:'0701 — папка с замком', note:'Оценка: складная папка, точная развёртка — по штампу.'},
 '0710':{name:'0710 — папка так-замок', note:'Оценка: складная папка, точная развёртка — по штампу.'},
 '0711':{name:'0711 — папка-автомат', note:'Оценка: складная папка, точная развёртка — по штампу.'},
 '0713':{name:'0713 — почтовый самосбор', note:'Оценка: crash-lock для e-commerce, только штамп или плоттер.'},
 '0771':{name:'0771 — шоу-бокс', note:'Оценка: лоток + крышка для полок, точная развёртка — по штампу.'}};
function lastCalc(){const L=+$('cl').value,W=+$('cw').value,H=+$('ch').value;
  const F=FLUTE[$('cf').value]||FLUTE.C, t=F.t, ECT=+$('cg').value, M=+$('cm').value||0, Q=Math.max(1,parseInt($('cq').value)||1), P=+$('cp').value||0;
  const ct=$('ct').value, T=TYPES[ct]||TYPES['0201'];
  if(!(L>0&&W>0&&H>0))return null;
  const glue=Math.min(40,Math.max(20,0.15*W));
  let Lb,Wb,mul=1,flapTop=W/2,flapBot=W/2;
  if(ct==='0200'){Lb=2*(L+W)+glue;Wb=H+W/2;flapTop=0;}
  else if(ct==='0202'){Lb=2*(L+W)+glue;Wb=H+2*W;flapTop=W;flapBot=W;}
  else if(ct==='0203'){Lb=2*(L+W)+glue;Wb=H+2*W;flapTop=W;flapBot=W;}
  else if(ct==='0301'){Lb=2*(L+W)+glue;Wb=H+W/2;mul=2;flapTop=0;}
  else if(ct==='0427'){
    const D=H, Th=t;
    Lb = L + 2*D + W + 40 + 4*Th;
    Wb = W + 2*D + W + 2*Th + 15;
    mul=1; flapTop=0; flapBot=0;
  }
  else if(ct==='0452'||ct==='0454'||ct==='0471'||ct==='0713'){Lb=2*(L+W)+glue;Wb=H+W;mul=ct==='0471'?1.15:ct==='0452'?1.2:ct==='0454'?1.3:1.35;}
  else if(ct==='0701'||ct==='0710'||ct==='0711'){Lb=2*L+W+40;Wb=2*H+W;}
  else if(ct==='0771'){Lb=2*(L+W)+glue;Wb=H+W/2;mul=1.8;flapTop=0;}
  else{Lb=2*(L+W)+glue;Wb=H+W;}
  const area=Lb*Wb/1e6*mul, total=area*Q;
  const mBox=area*F.g/1000;
  const Z=2*(L+W), BCT=5.87*ECT*Math.sqrt(t*Z);
  const tiers=M>0?Math.max(1,Math.floor(BCT/(M*9.81*3))):null;
  return {L,W,H,t,ECT,M,Q,P,Lb,Wb,area,total,mBox,BCT,tiers,fl:$('cf').value,ct,T,flapTop,flapBot,glue};
}
function drawPreview(r){const svg=$('draw');svg.innerHTML='';if(!r)return;
  $('drawTitle').textContent='Схема заготовки ' + r.ct;
  const sc=Math.min(940/r.Lb,280/r.Wb), X=v=>30+v*sc, Y=v=>30+v*sc;
  const cut='var(--brand)', score='#f59e0b', dim='var(--muted)';
  const flapT=r.flapTop||0, flapB=r.flapBot||0;
  function R(x,y,w,h){el('rect',{x:X(x),y:Y(y),width:Math.max(2,w*sc),height:Math.max(2,h*sc),fill:'none',stroke:cut,'stroke-width':2},svg)}
  function S(x1,y1,x2,y2){el('line',{x1:X(x1),y1:Y(y1),x2:X(x2),y2:Y(y2),stroke:score,'stroke-width':1.6},svg)}
  function Dim(x1,y1,x2,y2,label){
    const mx=(x1+x2)/2, my=(y1+y2)/2;
    el('line',{x1:X(x1),y1:Y(y1),x2:X(x2),y2:Y(y2),stroke:dim,'stroke-width':1},svg);
    el('line',{x1:X(x1),y1:Y(y1)-6,x2:X(x1),y2:Y(y1)+6,stroke:dim,'stroke-width':1},svg);
    el('line',{x1:X(x2),y1:Y(y2)-6,x2:X(x2),y2:Y(y2)+6,stroke:dim,'stroke-width':1},svg);
    const t=el('text',{x:X(mx),y:Y(my)-8,'text-anchor':'middle','font-size':10,fill:dim},svg);
    t.textContent=label;
  }
  if(r.ct==='0200'||r.ct==='0301'||r.ct==='0771'){const bodyH=r.Wb-flapT;
    if(flapT>0)R(0,0,r.Lb,flapT); R(0,flapT,r.Lb,bodyH);
    [0,r.L,r.L+r.W,2*r.L+r.W].forEach(x=>S(x,flapT,x,flapT+bodyH)); if(flapT>0)S(0,flapT,r.Lb,flapT);
    Dim(0,r.Wb+12,r.Lb,r.Wb+12,`${Math.round(r.Lb)}`);
    Dim(r.Lb+12,0,r.Lb+12,r.Wb,`${Math.round(r.Wb)}`);
  }else if(r.ct==='0427'){
    const L=r.L, W=r.W, D=r.H, Th=r.t;
    const cx=r.Lb/2, cy=r.Wb/2;
    const x0=cx-L/2, y0=cy-W/2;
    const yFront=y0-D, yBack=y0+W;
    const xl1=x0-D, xl2=x0-D/2;
    const xr1=x0+L, xr3=x0+L+D;
    const yLid=yBack+D, yLidTop=yLid+W;
    const earW=D*0.85, earR=D*0.35;
    const inset=11;
    S(x0,y0,x0+L,y0); S(x0,y0+W,x0+L,y0+W);
    S(x0,y0,x0,y0+W); S(x0+L,y0,x0+L,y0+W);
    S(x0,yFront,x0+L,yFront); S(x0,yFront,x0,y0); S(x0+L,yFront,x0+L,y0);
    S(x0,yBack,x0+L,yBack);
    S(xl1,y0,xl1,y0+W); S(xl1+D/2,y0,xl1+D/2,y0+W);
    S(xr1,y0,xr1,y0+W); S(xr1+D/2,y0,xr1+D/2,y0+W); S(xr3,y0,xr3,y0+W);
    S(x0,yLid,x0+L,yLid); S(x0,yLidTop,x0+L,yLidTop);
    S(x0,yLid,x0,yLidTop); S(x0+L,yLid,x0+L,yLidTop);
    const p=(pts)=>pts.map((pt,i)=>(i===0?`M${X(pt[0])} ${Y(pt[1])}`:`L${X(pt[0])} ${Y(pt[1])}`)).join(' ');
    const tongueW=L*0.18, tongueR=7, tx0=cx-tongueW/2, tx1=cx+tongueW/2;
    const notchD=6;
    function C(d){el('path',{d,fill:'none',stroke:cut,'stroke-width':2,'stroke-linejoin':'round','stroke-linecap':'round'},svg)}
    C(`${p([[xl1+notchD,y0],[xl1,y0],[xl1,y0+W],[xl1+notchD,y0+W]])} M${X(xl1)} ${Y(y0+W*0.35)} L${X(xl1)} ${Y(y0+W*0.45)} M${X(xl1)} ${Y(y0+W*0.55)} L${X(xl1)} ${Y(y0+W*0.65)}`);
    C(`${p([[xr3-notchD,y0],[xr3,y0],[xr3,y0+W],[xr3-notchD,y0+W]])} M${X(xr3)} ${Y(y0+W*0.35)} L${X(xr3)} ${Y(y0+W*0.45)} M${X(xr3)} ${Y(y0+W*0.55)} L${X(xr3)} ${Y(y0+W*0.65)}`);
    const cutPath=`M${X(x0+inset)} ${Y(yFront)} L${X(x0)} ${Y(yFront)} L${X(x0)} ${Y(y0)} L${X(xl1)} ${Y(y0)} L${X(xl1)} ${Y(y0+W)} L${X(x0)} ${Y(y0+W)} L${X(x0)} ${Y(yLid+W)} L${X(x0-earW)} ${Y(yLid+W)} L${X(x0-earW)} ${Y(yLid)} L${X(x0)} ${Y(yLid)} L${X(x0)} ${Y(yLidTop)} L${X(tx0)} ${Y(yLidTop)} A${earR*sc} ${earR*sc} 0 0 1 ${X(tx1)} ${Y(yLidTop)} L${X(x0+L)} ${Y(yLidTop)} L${X(x0+L)} ${Y(yLid)} L${X(x0+L+earW)} ${Y(yLid)} L${X(x0+L+earW)} ${Y(yLid+W)} L${X(x0+L)} ${Y(yLid+W)} L${X(x0+L)} ${Y(y0+W)} L${X(xr3)} ${Y(y0+W)} L${X(xr3)} ${Y(y0)} L${X(x0+L)} ${Y(y0)} L${X(x0+L)} ${Y(yFront)} L${X(x0+L-inset)} ${Y(yFront)} Z`;
    C(cutPath);
    const slotW=D*0.25, slotH=W*0.09;
    R(x0+D*0.05,y0+W*0.15,slotW,slotH); R(x0+L-D*0.05-slotW,y0+W*0.15,slotW,slotH);
    R(x0+D*0.05,y0+W*0.75-slotH,slotW,slotH); R(x0+L-D*0.05-slotW,y0+W*0.75-slotH,slotW,slotH);
    C(`M${X(x0)} ${Y(yLid)} A${earR*sc} ${earR*sc} 0 0 0 ${X(x0-earW)} ${Y(yLid+earR)}`);
    C(`M${X(x0+L)} ${Y(yLid)} A${earR*sc} ${earR*sc} 0 0 1 ${X(x0+L+earW)} ${Y(yLid+earR)}`);
    Dim(x0,y0+W+12,x0+L,y0+W+12,`${L}`);
    Dim(x0-12,y0,x0-12,y0+W,`${W}`);
    Dim(x0+L+12,y0,x0+L+12,y0+W,`${W} × D ${D}`);
  }else if(r.ct.indexOf('07')===0||r.ct==='0452'||r.ct==='0454'){const cx=r.Lb/2, cy=r.Wb/2;
    R(cx-r.L/2,cy-r.H/2,r.L,r.H);
    R(cx-r.L/2,cy-r.H/2-flapB,r.L,flapB);R(cx-r.L/2,cy+r.H/2,r.L,flapB);
    R(cx-r.L/2-(r.W/2),cy-r.H/2,r.W/2,r.H);R(cx+r.L/2,cy-r.H/2,r.W/2,r.H);
    S(cx-r.L/2,cy-r.H/2,cx+r.L/2,cy-r.H/2); S(cx-r.L/2,cy+r.H/2,cx+r.L/2,cy+r.H/2);
    S(cx-r.L/2,cy-r.H/2,cx-r.L/2,cy+r.H/2); S(cx+r.L/2,cy-r.H/2,cx+r.L/2,cy+r.H/2);
    Dim(cx-r.L/2,cy+r.H/2+12,cx+r.L/2,cy+r.H/2+12,`${r.L}`);
    Dim(cx-r.L/2-12,cy-r.H/2,cx-r.L/2-12,cy+r.H/2,`${r.H}`);
  }else{const flap=flapT;
    R(0,0,r.Lb,flap);R(0,flap,r.Lb,r.H);R(0,flap+r.H,r.Lb,flapB);
    [0,r.L,r.L+r.W,2*r.L+r.W].forEach(x=>S(x,flap,x,flap+r.H));
    S(0,flap,r.Lb,flap); S(0,flap+r.H,r.Lb,flap+r.H);
    Dim(0,r.Wb+14,r.Lb,r.Wb+14,`${Math.round(r.Lb)}`);
    Dim(r.Lb+14,0,r.Lb+14,r.Wb,`${Math.round(r.Wb)}`);
    Dim(0,flap-8,r.L,flap-8,`${r.L}`); Dim(r.L,flap-8,r.L+r.W,flap-8,`${r.W}`);}
  const a=el('text',{x:X(r.Lb/2),y:Y(r.Wb+28),'text-anchor':'middle','font-size':11,fill:dim},svg);
  a.textContent=`${Math.round(r.Lb)}×${Math.round(r.Wb)} мм · ${r.ct} · клапан ${Math.round(r.glue)} мм`;
}
function calc(){const out=$('out'),r=lastCalc();
  if(!r){out.textContent='Проверьте размеры.';return}
  out.innerHTML=`${r.T.name}. Заготовка: <b>${Math.round(r.Lb)}×${Math.round(r.Wb)} мм</b> (профиль ${r.fl})${r.T.note?`<br><span style="font-size:14px">${r.T.note}</span>`:''}<br>Картон: <b>${r.area.toFixed(2)} м²/шт</b> · ${r.Q} шт = ${r.total.toFixed(1)} м² · Вес ящика ≈ ${r.mBox.toFixed(2)} кг${r.P>0?`<br>Картон: <b>${(r.total*r.P).toFixed(0)} ₽</b>`:''}<br>BCT ≈ <b>${Math.round(r.BCT)} Н</b> (${(r.BCT/9.81).toFixed(0)} кгс)${r.tiers?` · Штабель: <b>${r.tiers} яр.</b>`:''}<br><span style="font-size:14px">BCT — оценка по Макки. Перед тиражом проверьте чертёж на плоттере.</span>`;
  drawPreview(r);
  try{const h=JSON.parse(localStorage.getItem('s06')||'[]');h.unshift({L:r.L,W:r.W,H:r.H,t:Date.now()});localStorage.setItem('s06',JSON.stringify(h.slice(0,20)))}catch(e){}
  try{window.s555ev&&s555ev('calc_run',{L:r.L})}catch(e){}
  return r;
}
function printSheet(){const r=lastCalc()||calc();const sh=$('psheet');if(!r)return;const d=new Date().toLocaleDateString('ru-RU');
  sh.innerHTML=`<h1>Коробка ${r.ct} — formgen.ru</h1><p>Дата: ${d}</p>
  <h2>Заказ</h2><table><tr><td>Внутренние, мм</td><td>${r.L}×${r.W}×${r.H}</td></tr><tr><td>Конструкция</td><td>${r.T.name}</td></tr><tr><td>Профиль / марка</td><td>${r.fl} / ECT ${r.ECT}</td></tr><tr><td>Заготовка</td><td>${Math.round(r.Lb)}×${Math.round(r.Wb)} мм</td></tr><tr><td>Картон</td><td>${r.area.toFixed(2)} м²/шт, всего ${r.total.toFixed(1)} м² (${r.Q} шт)</td></tr><tr><td>BCT</td><td>≈ ${Math.round(r.BCT)} Н${r.tiers?`, штабель ${r.tiers} яр.`:''}</td></tr></table>
  <h2>Нормативы</h2><ul><li>Типы коробок — каталог FEFCO. BCT — оценка по формуле Макки.</li><li>Сырость снижает прочность до 50% — для склада без отопления берите влагостойкий картон.</li></ul>
  <p><b>Важно:</b> перед тиражом проверьте чертёж на плоттере.</p>`;
}
function downloadSVG(){const svg=$('draw');const r=lastCalc()||calc();if(!svg||!r||!svg.innerHTML.trim())return;
  const clone=svg.cloneNode(true);
  clone.setAttribute('xmlns','http://www.w3.org/2000/svg');
  clone.querySelectorAll('[stroke="var(--brand)"]').forEach(el=>el.setAttribute('stroke','#1e3a8a'));
  clone.querySelectorAll('[stroke="var(--muted)"]').forEach(el=>el.setAttribute('stroke','#64748b'));
  clone.querySelectorAll('[fill="var(--muted)"]').forEach(el=>el.setAttribute('fill','#64748b'));
  const titleEl=document.createElementNS(NS,'title');titleEl.textContent=`formgen.ru ${r.ct} ${r.L}x${r.W}x${r.H} заготовка ${Math.round(r.Lb)}x${Math.round(r.Wb)}`;
  clone.insertBefore(titleEl, clone.firstChild);
  const blob=new Blob([new XMLSerializer().serializeToString(clone)],{type:'image/svg+xml'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`korob-${r.ct}-${r.L}x${r.W}x${r.H}.svg`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000);
  try{window.s555ev&&s555ev('svg_download',{ct:r.ct})}catch(e){}
}
function toDXF(r){
  let dxf='0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1009\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n';
  function line(x1,y1,x2,y2,layer){
    dxf+=`0\nLINE\n8\n${layer}\n10\n${x1}\n20\n${y1}\n30\n0\n11\n${x2}\n21\n${y2}\n31\n0\n`;
  }
  function rect(x,y,w,h,layer){ line(x,y,x+w,y,layer); line(x+w,y,x+w,y+h,layer); line(x+w,y+h,x,y+h,layer); line(x,y+h,x,y,layer); }
  const ft=r.flapTop||0, fb=r.flapBot||0;
  // cut lines on layer 0, score on layer 1
  if(r.ct==='0200'||r.ct==='0301'||r.ct==='0771'){
    const bh=r.Wb-ft;
    if(ft>0) rect(0,0,r.Lb,ft,'CUT');
    rect(0,ft,r.Lb,bh,'CUT');
    [0,r.L,r.L+r.W,2*r.L+r.W].forEach(x=> line(x,ft,x,ft+bh,'SCORE'));
    if(ft>0) line(0,ft,r.Lb,ft,'SCORE');
  } else if(r.ct==='0427'||r.ct.indexOf('07')===0||r.ct==='0452'||r.ct==='0454'){
    const cx=r.Lb/2, cy=r.Wb/2;
    rect(cx-r.L/2,cy-r.H/2,r.L,r.H,'CUT');
    rect(cx-r.L/2,cy-r.H/2-fb,r.L,fb,'CUT');
    rect(cx-r.L/2,cy+r.H/2,r.L,fb,'CUT');
    rect(cx-r.L/2-r.W/2,cy-r.H/2,r.W/2,r.H,'CUT');
    rect(cx+r.L/2,cy-r.H/2,r.W/2,r.H,'CUT');
    // scores
    line(cx-r.L/2,cy-r.H/2,cx+r.L/2,cy-r.H/2,'SCORE');
    line(cx-r.L/2,cy+r.H/2,cx+r.L/2,cy+r.H/2,'SCORE');
    line(cx-r.L/2,cy-r.H/2,cx-r.L/2,cy+r.H/2,'SCORE');
    line(cx+r.L/2,cy-r.H/2,cx+r.L/2,cy+r.H/2,'SCORE');
  } else {
    rect(0,0,r.Lb,ft,'CUT');
    rect(0,ft,r.Lb,r.H,'CUT');
    rect(0,ft+r.H,r.Lb,fb,'CUT');
    [0,r.L,r.L+r.W,2*r.L+r.W].forEach(x=> line(x,ft,x,ft+r.H,'SCORE'));
    line(0,ft,r.Lb,ft,'SCORE');
    line(0,ft+r.H,r.Lb,ft+r.H,'SCORE');
  }
  dxf+='0\nENDSEC\n0\nEOF';
  return dxf;
}
function downloadDXF(){const r=lastCalc()||calc();if(!r)return;
  const dxf=toDXF(r);
  const blob=new Blob([dxf],{type:'application/dxf'});
  const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`korob-${r.ct}-${r.L}x${r.W}x${r.H}.dxf`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000);
  try{window.s555ev&&s555ev('dxf_download',{ct:r.ct})}catch(e){}
}
function downloadPDF(){const r=lastCalc()||calc();if(!r)return;
  const {jsPDF}=window.jspdf||{};
  if(!jsPDF){alert('PDF библиотека не загружена');return;}
  const doc=new jsPDF({unit:'mm',format:[r.Lb+20,r.Wb+20]});
  doc.setFontSize(8);
  doc.text(`formgen.ru ${r.ct} ${r.L}x${r.W}x${r.H} заготовка ${Math.round(r.Lb)}x${Math.round(r.Wb)}`,10,10);
  // draw outer
  doc.setDrawColor(30,58,138); doc.setLineWidth(0.5);
  const ft=r.flapTop||0, fb=r.flapBot||0;
  function rct(x,y,w,h){doc.rect(10+x,10+y,w,h);}
  function ln(x1,y1,x2,y2){doc.line(10+x1,10+y1,10+x2,10+y2);}
  doc.setDrawColor(245,158,11); doc.setLineWidth(0.4); doc.setLineDash([]);
  if(r.ct==='0200'||r.ct==='0301'||r.ct==='0771'){
    const bh=r.Wb-ft;
    if(ft>0) rct(0,0,r.Lb,ft);
    rct(0,ft,r.Lb,bh);
    [0,r.L,r.L+r.W,2*r.L+r.W].forEach(x=> ln(x,ft,x,ft+bh));
  } else if(r.ct==='0427'||r.ct.indexOf('07')===0||r.ct==='0452'||r.ct==='0454'){
    const cx=r.Lb/2, cy=r.Wb/2;
    rct(cx-r.L/2,cy-r.H/2,r.L,r.H);
    rct(cx-r.L/2,cy-r.H/2-fb,r.L,fb); rct(cx-r.L/2,cy+r.H/2,r.L,fb);
    rct(cx-r.L/2-r.W/2,cy-r.H/2,r.W/2,r.H); rct(cx+r.L/2,cy-r.H/2,r.W/2,r.H);
  } else {
    rct(0,0,r.Lb,ft); rct(0,ft,r.Lb,r.H); rct(0,ft+r.H,r.Lb,fb);
    [0,r.L,r.L+r.W,2*r.L+r.W].forEach(x=> ln(x,ft,x,ft+r.H));
  }
  doc.save(`korob-${r.ct}-${r.L}x${r.W}x${r.H}.pdf`);
  try{window.s555ev&&s555ev('pdf_download',{ct:r.ct})}catch(e){}
}
