---
const SITE = 'https://formgen.ru';
const title = 'Печать этикеток для гофрооборудования | formgen.ru';
const desc = 'Сервис печати этикеток 24×80 мм для биговок, рицовок, перфорации и ножей. Вставьте таблицу из Excel — получите PDF с спуском на А4.';
---
<!doctype html>
<html lang="ru">
<head>
<script is:inline src="../theme-head.js"></script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={SITE + '/label/'} />
<link rel="alternate" hreflang="ru" href={SITE + '/label/'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:type" content="website" />
<link rel="icon" type="image/svg+xml" href="../favicon.svg" />
<link rel="stylesheet" href="../_s555.css?v=1" />
<style>
  .label-paste { min-height: 200px; font-family: var(--mono); font-size: 13px; line-height: 1.4; resize: vertical; width: 100%; padding: 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); color: var(--fg); }
  .label-paste:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-light); }
  .label-table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14px; }
  .label-table th, .label-table td { border: 1px solid var(--line); padding: 8px 12px; text-align: left; }
  .label-table th { background: var(--card); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .label-table tr:nth-child(even) td { background: var(--card); }
  .label-preview { display: grid; gap: 8px; margin: 16px 0; }
  .label-card { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--card); }
  .label-card .info { padding: 10px 14px; font-size: 13px; color: var(--muted); }
  .label-card .info b { color: var(--fg); }
  .label-svg-wrap { padding: 8px; background: #fff; border-bottom: 1px solid var(--line); }
  .label-svg-wrap svg { display: block; width: 100%; max-width: 320px; margin: 0 auto; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
  .hint { font-size: 13px; color: var(--muted); margin: 8px 0; }
  .error { background: var(--danger-light); color: var(--danger); border: 1px solid var(--danger); border-radius: var(--radius); padding: 12px 16px; margin: 12px 0; font-size: 14px; }
  .stat { display: inline-flex; align-items: center; gap: 6px; background: var(--accent-light); color: var(--accent); border-radius: 20px; padding: 4px 12px; font-size: 13px; font-weight: 600; margin: 8px 0; }
</style>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script is:inline src="../theme.js" defer></script>
</head>
<body>
<div class="bg-field" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
<header class="site"><div class="wrap"><nav>
  <a class="brand" href="../" aria-label="formgen — на главную"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 11 L16 6 L26 11 L26 23 L16 28 L6 23 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M6 11 L16 16 L26 11 M16 16 L16 28" stroke="var(--accent)" stroke-width="2"/></svg><span>formgen<small>.ru</small></span></a>
  <button class="burger" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="Меню"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path class="l1" d="M2 5h16"/><path class="l2" d="M2 10h16"/><path class="l3" d="M2 15h16"/></svg></button>
  <div class="nav-links" id="navlinks">
    <a href="../">Калькулятор</a>
    <a href="../fefco/">Коробки FEFCO</a>
    <a href="../gofro/">Гофрокартон</a>
    <a href="../prochnost/">Прочность</a>
    <a href="../primery/">Примеры</a>
    <a href="./" aria-current="page">Этикетки</a>
  </div>
</nav></div></header>

<main class="wrap">
<section class="hero">
  <p class="eyebrow">Печать этикеток</p>
  <h1>Этикетки 24×80 мм для оборудования</h1>
  <p>Вставьте таблицу из Excel — получите PDF с этикетками для биговок, рицовок, перфорации и ножей.</p>
</section>

<div class="answer">
  <b>Формат:</b> Тип (Б/Р/П/Н) · Толщина (2/3/4/6 пт) · Заточка (А/АА) · Высота (для Б/Р) · Производитель · Количество
</div>

<section class="calc" aria-label="Генератор этикеток">
  <div>
    <label style="display:block;font-size:14px;font-weight:500;color:var(--muted);margin-bottom:6px">Вставьте таблицу из Excel (Ctrl+V)</label>
    <textarea id="paste" class="label-paste" placeholder="Б	2 пт	А	23.30	Armor	10&#10;Р	3 пт	АА	23.30	Корея	5&#10;П	2 пт	А	3x3	Plast X	8&#10;Н	4 пт	А		Armor	3"></textarea>
    <p class="hint">Табуляция между колонками. Порядок: Тип · Толщина · Заточка · Высота · Производитель · Количество</p>
  </div>

  <div id="error" class="error" hidden></div>

  <div id="parsedInfo" hidden>
    <div id="stats"></div>
    <table class="label-table">
      <thead><tr><th>Тип</th><th>Толщина</th><th>Заточка</th><th>Высота</th><th>Производитель</th><th>Кол-во</th></tr></thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>

  <div class="actions">
    <button class="btn" id="parseBtn">Разобрать таблицу</button>
    <button class="btn ghost" id="pdfBtn" disabled>Скачать PDF</button>
    <button class="btn ghost" id="printBtn" disabled>Печать</button>
  </div>

  <div id="preview" class="label-preview" hidden></div>
</section>
</main>

<footer class="site"><div class="wrap"><div class="fgrid">
  <div><h3>formgen.ru</h3><p>Калькулятор гофротары и сервис печати этикеток. Обновлено 2026-09-20.</p></div>
  <div><h3>Инструменты</h3><ul><li><a href="../">Калькулятор 0201</a></li><li><a href="./">Этикетки</a></li></ul></div>
  <div><h3>Справочник</h3><ul><li><a href="../fefco/">Типы FEFCO</a></li><li><a href="../gofro/">Гофрокартон</a></li></ul></div>
</div></div></footer>

<script is:inline>
const $ = id => document.getElementById(id);

function parseTable(text) {
  const lines = text.trim().split('\n').filter(l => l.trim());
  const rows = [];
  for (const line of lines) {
    const cols = line.split('\t').map(c => c.trim()).filter(c => c);
    if (cols.length < 4) continue;
    const type = cols[0].toUpperCase();
    if (!['Б','Р','П','Н'].includes(type)) continue;
    rows.push({
      type,
      thickness: cols[1] || '',
      edge: cols[2] || '',
      height: cols[3] || '',
      manufacturer: cols[4] || '',
      qty: parseInt(cols[5]) || 1
    });
  }
  return rows;
}

function showError(msg) {
  const el = $('error');
  el.textContent = msg;
  el.hidden = !msg;
}

function renderLabelSVG(item) {
  const W = 80, H = 24;
  const isKnife = item.type === 'Н';
  const typeNames = { 'Б': 'Б', 'Р': 'Р', 'П': 'П', 'Н': 'Н' };
  const letter = typeNames[item.type] || item.type;

  if (isKnife) {
    // Knife label: black left with thickness, then edge type, manufacturer
    const leftW = 20;
    return `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="font-family:Arial,sans-serif">
      <rect x="0" y="0" width="${W}" height="${H}" fill="#fff" stroke="#000" stroke-width="0.3"/>
      <rect x="0" y="0" width="${leftW}" height="${H}" fill="#000"/>
      <text x="${leftW/2}" y="${H/2 - 1}" text-anchor="middle" fill="#fff" font-size="6" font-weight="700">${item.thickness}</text>
      <text x="${leftW/2}" y="${H/2 + 4.5}" text-anchor="middle" fill="#fff" font-size="5" font-weight="400">пт</text>
      <text x="${leftW + 8}" y="${H/2 - 1}" text-anchor="middle" fill="#000" font-size="8" font-weight="800">${item.edge || ''}</text>
      <line x1="${leftW + 2}" y1="${H/2 + 2}" x2="${W - 2}" y2="${H/2 + 2}" stroke="#000" stroke-width="0.2"/>
      <text x="${leftW + 8}" y="${H/2 + 6}" text-anchor="middle" fill="#000" font-size="5">${item.manufacturer}</text>
    </svg>`;
  }

  // Bigovki / Ritsovki / Perforation label
  const leftW = 14;
  if (item.type === 'П') {
    // Perforation: letter + thickness | dimensions (e.g. 3x3)
    return `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="font-family:Arial,sans-serif">
      <rect x="0" y="0" width="${W}" height="${H}" fill="#fff" stroke="#000" stroke-width="0.3"/>
      <text x="${leftW/2 + 1}" y="${H/2 + 3}" text-anchor="middle" fill="#000" font-size="14" font-weight="900" letter-spacing="-0.5">${letter}</text>
      <line x1="${leftW + 1}" y1="1" x2="${leftW + 1}" y2="${H - 1}" stroke="#000" stroke-width="0.2"/>
      <text x="${leftW + 10}" y="${H/2 - 0.5}" text-anchor="middle" fill="#000" font-size="7" font-weight="700">${item.thickness}</text>
      <line x1="${leftW + 18}" y1="${H/2 + 1}" x2="${W - 2}" y2="${H/2 + 1}" stroke="#000" stroke-width="0.2"/>
      <text x="${leftW + 10}" y="${H/2 + 5.5}" text-anchor="middle" fill="#000" font-size="5.5">${item.manufacturer}</text>
      <text x="${W - 4}" y="${H/2 - 0.5}" text-anchor="end" fill="#000" font-size="7" font-weight="700">${item.height || ''}</text>
    </svg>`;
  }

  // Bigovki / Ritsovki: letter + thickness + height (black bg) + manufacturer
  return `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="font-family:Arial,sans-serif">
    <rect x="0" y="0" width="${W}" height="${H}" fill="#fff" stroke="#000" stroke-width="0.3"/>
    <text x="${leftW/2 + 1}" y="${H/2 + 3}" text-anchor="middle" fill="#000" font-size="14" font-weight="900" letter-spacing="-0.5">${letter}</text>
    <line x1="${leftW + 1}" y1="1" x2="${leftW + 1}" y2="${H - 1}" stroke="#000" stroke-width="0.2"/>
    <text x="${leftW + 10}" y="${H/2 - 0.5}" text-anchor="middle" fill="#000" font-size="7" font-weight="700">${item.thickness}</text>
    <rect x="${W - 22}" y="1" width="21" height="${H - 2}" fill="#000" rx="1"/>
    <text x="${W - 11.5}" y="${H/2 + 0.5}" text-anchor="middle" fill="#fff" font-size="7" font-weight="800">${item.height || ''}</text>
    <line x1="${leftW + 18}" y1="${H/2 + 1}" x2="${W - 24}" y2="${H/2 + 1}" stroke="#000" stroke-width="0.2"/>
    <text x="${leftW + 10}" y="${H/2 + 5.5}" text-anchor="middle" fill="#000" font-size="5.5">${item.manufacturer}</text>
  </svg>`;
}

let parsedData = [];

$('parseBtn').onclick = function() {
  showError('');
  const text = $('paste').value;
  if (!text.trim()) { showError('Вставьте таблицу из Excel'); return; }

  parsedData = parseTable(text);
  if (!parsedData.length) { showError('Не удалось распознать строки. Проверьте формат: Тип \\t Толщина \\t Заточка \\t Высота \\t Производитель \\t Количество'); return; }

  // Show table
  const tbody = $('tbody');
  tbody.innerHTML = '';
  let totalLabels = 0;
  for (const row of parsedData) {
    totalLabels += row.qty;
    const tr = document.createElement('tr');
    tr.innerHTML = `<td><b>${row.type}</b></td><td>${row.thickness}</td><td>${row.edge}</td><td>${row.height || '—'}</td><td>${row.manufacturer}</td><td>${row.qty}</td>`;
    tbody.appendChild(tr);
  }
  $('parsedInfo').hidden = false;
  $('stats').innerHTML = `<span class="stat">${parsedData.length} типов · ${totalLabels} этикеток</span>`;

  // Show preview (first of each type)
  const preview = $('preview');
  preview.hidden = false;
  preview.innerHTML = '<span class="result-label">Примеры этикеток</span>';
  const shown = new Set();
  for (const row of parsedData) {
    if (shown.has(row.type)) continue;
    shown.add(row.type);
    const card = document.createElement('div');
    card.className = 'label-card';
    card.innerHTML = `<div class="label-svg-wrap">${renderLabelSVG(row)}</div><div class="info"><b>${row.type}</b> · ${row.thickness} · ${row.edge} · ${row.manufacturer} · ${row.qty} шт</div>`;
    preview.appendChild(card);
  }

  $('pdfBtn').disabled = false;
  $('printBtn').disabled = false;
};

function generatePDF() {
  const { jsPDF } = window.jspdf || {};
  if (!jsPDF) { alert('PDF библиотека не загружена'); return; }

  const doc = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });
  const pageW = 210, pageH = 297;
  const labelW = 80, labelH = 24;
  const cols = Math.floor(pageW / labelW);
  const rows = Math.floor(pageH / labelH);
  const labelsPerPage = cols * rows;
  const marginX = (pageW - cols * labelW) / 2;
  const marginY = (pageH - rows * labelH) / 2;

  // Expand data by quantity
  const allLabels = [];
  for (const item of parsedData) {
    for (let i = 0; i < item.qty; i++) {
      allLabels.push(item);
    }
  }

  let labelIdx = 0;
  let page = 0;

  while (labelIdx < allLabels.length) {
    if (labelIdx > 0) { doc.addPage(); page++; }

    // Draw cut marks (corner marks)
    doc.setDrawColor(0);
    doc.setLineWidth(0.1);
    const markLen = 3;
    for (let r = 0; r <= rows; r++) {
      for (let c = 0; c <= cols; c++) {
        const x = marginX + c * labelW;
        const y = marginY + r * labelH;
        // Top-left corner mark
        if (c > 0 && r > 0) {
          doc.line(x - markLen/2, y, x + markLen/2, y);
          doc.line(x, y - markLen/2, x, y + markLen/2);
        }
      }
    }
    // Bottom-right page corner mark
    const ex = marginX + cols * labelW;
    const ey = marginY + rows * labelH;
    doc.line(ex - markLen/2, ey, ex + markLen/2, ey);
    doc.line(ex, ey - markLen/2, ex, ey + markLen/2);

    // Draw labels
    for (let i = 0; i < labelsPerPage && labelIdx < allLabels.length; i++) {
      const col = i % cols;
      const row = Math.floor(i / cols);
      const x = marginX + col * labelW;
      const y = marginY + row * labelH;
      const item = allLabels[labelIdx];

      drawLabelOnPDF(doc, item, x, y, labelW, labelH);
      labelIdx++;
    }
  }

  doc.save('etiketki-24x80.pdf');
}

function drawLabelOnPDF(doc, item, x, y, w, h) {
  const isKnife = item.type === 'Н';

  // Label border
  doc.setDrawColor(0);
  doc.setLineWidth(0.2);
  doc.setFillColor(255, 255, 255);
  doc.rect(x, y, w, h, 'FD');

  if (isKnife) {
    // Knife: black left block with thickness
    const leftW = 7;
    doc.setFillColor(0, 0, 0);
    doc.rect(x, y, leftW, h, 'F');
    doc.setTextColor(255);
    doc.setFontSize(8);
    doc.setFont('helvetica', 'bold');
    doc.text(item.thickness, x + leftW/2, y + h/2 - 1, { align: 'center' });
    doc.setFontSize(5);
    doc.setFont('helvetica', 'normal');
    doc.text('пт', x + leftW/2, y + h/2 + 3, { align: 'center' });

    // Edge type (A/AA)
    doc.setTextColor(0);
    doc.setFontSize(10);
    doc.setFont('helvetica', 'bold');
    doc.text(item.edge || '', x + leftW + 12, y + h/2 + 0.5, { align: 'center' });

    // Separator line
    doc.setDrawColor(0);
    doc.setLineWidth(0.1);
    doc.line(x + leftW + 3, y + h/2 + 2.5, x + w - 3, y + h/2 + 2.5);

    // Manufacturer
    doc.setFontSize(5.5);
    doc.setFont('helvetica', 'normal');
    doc.text(item.manufacturer || '', x + leftW + 12, y + h/2 + 5.5, { align: 'center' });
    return;
  }

  // Bigovki / Ritsovki / Perforation
  const leftW = 7;

  // Large type letter
  doc.setTextColor(0);
  doc.setFontSize(16);
  doc.setFont('helvetica', 'bold');
  doc.text(item.type, x + leftW/2 + 0.5, y + h/2 + 2, { align: 'center' });

  // Separator line after letter
  doc.setDrawColor(0);
  doc.setLineWidth(0.1);
  doc.line(x + leftW + 1, y + 1, x + leftW + 1, y + h - 1);

  // Thickness
  doc.setFontSize(8);
  doc.setFont('helvetica', 'bold');
  doc.text(item.thickness, x + leftW + 9, y + h/2 - 0.5, { align: 'center' });

  // Separator line under thickness
  doc.line(x + leftW + 2, y + h/2 + 2, x + w - 24, y + h/2 + 2);

  // Manufacturer
  doc.setFontSize(5.5);
  doc.setFont('helvetica', 'normal');
  doc.text(item.manufacturer || '', x + leftW + 9, y + h/2 + 5.5, { align: 'center' });

  // Black block with height (for Б/Р) or dimensions (for П)
  if (item.type === 'П') {
    // Perforation: show dimensions
    doc.setFontSize(8);
    doc.setFont('helvetica', 'bold');
    doc.text(item.height || '', x + w - 4, y + h/2 - 0.5, { align: 'right' });
  } else {
    // Black block
    doc.setFillColor(0, 0, 0);
    doc.rect(x + w - 22, y + 1, 21, h - 2, 'F');
    doc.setTextColor(255);
    doc.setFontSize(8);
    doc.setFont('helvetica', 'bold');
    doc.text(item.height || '', x + w - 11.5, y + h/2 + 0.5, { align: 'center' });
  }
}

$('pdfBtn').onclick = generatePDF;

$('printBtn').onclick = function() {
  if (!parsedData.length) return;
  generatePDF();
};

// Auto-parse on paste
$('paste').addEventListener('paste', function() {
  setTimeout(() => { $('parseBtn').click(); }, 100);
});
</script>
</body>
</html>
