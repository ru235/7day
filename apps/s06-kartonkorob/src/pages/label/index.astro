---
const SITE = 'https://formgen.ru';
const title = 'Печать этикеток для гофрооборудования | formgen.ru';
const desc = 'Сервис печати этикеток 24×80 мм для биговок, рицовок, перфорации и ножей. Вставьте таблицу из Excel — получите PDF с спуском на А4.';
---
<!doctype html>
<html lang="ru">
<head>
<script is:inline src="../theme-head.js"></script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={SITE + '/label/'} />
<link rel="alternate" hreflang="ru" href={SITE + '/label/'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:type" content="website" />
<link rel="icon" type="image/svg+xml" href="../favicon.svg" />
<link rel="stylesheet" href="../_s555.css?v=1" />
<style>
  .label-paste { min-height: 180px; font-family: var(--mono); font-size: 13px; line-height: 1.4; resize: vertical; width: 100%; padding: 14px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); color: var(--fg); }
  .label-paste:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-light); }
  .label-table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 14px; }
  .label-table th, .label-table td { border: 1px solid var(--line); padding: 8px 12px; text-align: left; }
  .label-table th { background: var(--card); font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .label-table tr:nth-child(even) td { background: var(--card); }
  .label-preview { display: grid; gap: 10px; margin: 20px 0; }
  .label-card { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--card); }
  .label-card .info { padding: 8px 14px; font-size: 13px; color: var(--muted); }
  .label-card .info b { color: var(--fg); }
  .label-svg-wrap { padding: 10px; background: #fff; display: flex; align-items: center; justify-content: center; }
  .label-svg-wrap svg { display: block; width: 320px; height: 96px; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
  .hint { font-size: 13px; color: var(--muted); margin: 8px 0; }
  .error { background: var(--danger-light); color: var(--danger); border: 1px solid var(--danger); border-radius: var(--radius); padding: 12px 16px; margin: 12px 0; font-size: 14px; }
  .stat { display: inline-flex; align-items: center; gap: 6px; background: var(--accent-light); color: var(--accent); border-radius: 20px; padding: 4px 12px; font-size: 13px; font-weight: 600; margin: 8px 0; }
</style>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script is:inline src="../theme.js" defer></script>
</head>
<body>
<div class="bg-field" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
<header class="site"><div class="wrap"><nav>
  <a class="brand" href="../" aria-label="formgen — на главную"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 11 L16 6 L26 11 L26 23 L16 28 L6 23 Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><path d="M6 11 L16 16 L26 11 M16 16 L16 28" stroke="var(--accent)" stroke-width="2"/></svg><span>formgen<small>.ru</small></span></a>
  <button class="burger" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="Меню"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path class="l1" d="M2 5h16"/><path class="l2" d="M2 10h16"/><path class="l3" d="M2 15h16"/></svg></button>
  <div class="nav-links" id="navlinks">
    <a href="../">Калькулятор</a>
    <a href="../fefco/">Коробки FEFCO</a>
    <a href="../gofro/">Гофрокартон</a>
    <a href="../prochnost/">Прочность</a>
    <a href="../primery/">Примеры</a>
    <a href="./" aria-current="page">Этикетки</a>
  </div>
</nav></div></header>

<main class="wrap">
<section class="hero">
  <p class="eyebrow">Печать этикеток</p>
  <h1>Этикетки 24×80 мм для оборудования</h1>
  <p>Вставьте таблицу из Excel — получите PDF с этикетками для биговок, рицовок, перфорации и ножей.</p>
</section>

<div class="answer">
  <b>Формат:</b> Тип (Б/Р/П/Н) · Толщина (2/3/4/6 пт) · Заточка (А/АА) · Высота (для Б/Р) · Производитель · Количество
</div>

<section class="calc" aria-label="Генератор этикеток">
  <div>
    <label style="display:block;font-size:14px;font-weight:500;color:var(--muted);margin-bottom:6px">Вставьте таблицу из Excel (Ctrl+V)</label>
    <textarea id="paste" class="label-paste" placeholder="Б	2 пт	А	23.30	Armor	10&#10;Р	3 пт	АА	23.30	Корея	5&#10;П	2 пт	А	3x3	Plast X	8&#10;Н	4 пт	А		Armor	3"></textarea>
    <p class="hint">Табуляция между колонками. Порядок: Тип · Толщина · Заточка · Высота · Производитель · Количество</p>
  </div>

  <div id="error" class="error" hidden></div>

  <div id="parsedInfo" hidden>
    <div id="stats"></div>
    <table class="label-table">
      <thead><tr><th>Тип</th><th>Толщина</th><th>Заточка</th><th>Высота</th><th>Производитель</th><th>Кол-во</th></tr></thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>

  <div class="actions">
    <button class="btn" id="parseBtn">Разобрать таблицу</button>
    <button class="btn ghost" id="pdfBtn" disabled>Скачать PDF</button>
  </div>

  <div id="preview" class="label-preview" hidden></div>
</section>
</main>

<footer class="site"><div class="wrap"><div class="fgrid">
  <div><h3>formgen.ru</h3><p>Калькулятор гофротары и сервис печати этикеток. Обновлено 2026-09-20.</p></div>
  <div><h3>Инструменты</h3><ul><li><a href="../">Калькулятор 0201</a></li><li><a href="./">Этикетки</a></li></ul></div>
  <div><h3>Справочник</h3><ul><li><a href="../fefco/">Типы FEFCO</a></li><li><a href="../gofro/">Гофрокартон</a></li></ul></div>
</div></div></footer>

<script is:inline>
const $ = id => document.getElementById(id);

function parseTable(text) {
  const lines = text.trim().split('\n').filter(l => l.trim());
  const rows = [];
  for (const line of lines) {
    const cols = line.split('\t').map(c => c.trim()).filter(c => c);
    if (cols.length < 4) continue;
    const type = cols[0].toUpperCase();
    if (!['Б','Р','П','Н'].includes(type)) continue;
    rows.push({
      type,
      thickness: cols[1] || '',
      edge: cols[2] || '',
      height: cols[3] || '',
      manufacturer: cols[4] || '',
      qty: parseInt(cols[5]) || 1
    });
  }
  return rows;
}

function showError(msg) {
  const el = $('error');
  el.textContent = msg;
  el.hidden = !msg;
}

function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
const FF = 'Calibri,Segoe UI,Arial,sans-serif';

function renderLabelSVG(item) {
  const W = 80, H = 24;
  const isKnife = item.type === 'Н';
  const typeNames = { 'Б': 'Б', 'Р': 'Р', 'П': 'П' };

  // Б/Р/П layout:
  // Letter zone: 0-24mm wide, full height 24mm
  // Top zone (0-15mm): thickness (24-52) | black block with height (52-80)
  // Bottom zone (15-24mm): manufacturer centered (24-80)
  const letterW = 24;
  const topH = 15;
  const botY = topH;
  const botH = H - topH;
  const rightStart = letterW;
  const rightW = W - letterW;
  const midX = letterW + rightW / 2;

  if (isKnife) {
    // Knife: black block 0-24 full height, edge type 24-80 top half, manufacturer bottom
    return `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="font-family:${FF}">
      <rect x="0" y="0" width="${W}" height="${H}" fill="#fff"/>
      <rect x="0" y="0" width="${letterW}" height="${H}" fill="#000"/>
      <text x="${letterW/2}" y="${H/2 + 5}" text-anchor="middle" fill="#fff" font-size="20" font-weight="900">${esc(item.thickness.replace(/\s*пт\s*/,''))}</text>
      <text x="${letterW/2}" y="${H/2 + 11}" text-anchor="middle" fill="#fff" font-size="8" font-weight="700">пт</text>
      <line x1="${letterW}" y1="0" x2="${letterW}" y2="${H}" stroke="#000" stroke-width="0.3"/>
      <text x="${letterW + rightW/2}" y="${topH/2 + 4}" text-anchor="middle" fill="#000" font-size="14" font-weight="900">${esc(item.edge || '')}</text>
      <line x1="${letterW}" y1="${topH}" x2="${W}" y2="${topH}" stroke="#000" stroke-width="0.3"/>
      <text x="${W/2}" y="${botY + botH/2 + 2.5}" text-anchor="middle" fill="#000" font-size="7">${esc(item.manufacturer)}</text>
    </svg>`;
  }

  const letter = typeNames[item.type] || item.type;

  if (item.type === 'П') {
    return `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="font-family:${FF}">
      <rect x="0" y="0" width="${W}" height="${H}" fill="#fff"/>
      <text x="${letterW/2}" y="${H/2 + 7}" text-anchor="middle" fill="#000" font-size="22" font-weight="900">${esc(letter)}</text>
      <line x1="${letterW}" y1="0" x2="${letterW}" y2="${H}" stroke="#000" stroke-width="0.3"/>
      <text x="${letterW + rightW/4}" y="${topH/2 + 4}" text-anchor="middle" fill="#000" font-size="10" font-weight="700">${esc(item.thickness)}</text>
      <text x="${letterW + rightW*3/4}" y="${topH/2 + 4}" text-anchor="middle" fill="#000" font-size="10" font-weight="900">${esc(item.height || '')}</text>
      <line x1="${letterW}" y1="${topH}" x2="${W}" y2="${topH}" stroke="#000" stroke-width="0.3"/>
      <text x="${W/2}" y="${botY + botH/2 + 2.5}" text-anchor="middle" fill="#000" font-size="7">${esc(item.manufacturer)}</text>
    </svg>`;
  }

  // Б / Р: letter 0-24 | thickness 24-52 top | black block 52-80 top | manufacturer bottom
  const blkX = 52, blkW = 28;
  return `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="font-family:${FF}">
    <rect x="0" y="0" width="${W}" height="${H}" fill="#fff"/>
    <text x="${letterW/2}" y="${H/2 + 7}" text-anchor="middle" fill="#000" font-size="22" font-weight="900">${esc(letter)}</text>
    <line x1="${letterW}" y1="0" x2="${letterW}" y2="${H}" stroke="#000" stroke-width="0.3"/>
    <text x="${letterW + rightW/4}" y="${topH/2 + 4}" text-anchor="middle" fill="#000" font-size="10" font-weight="700">${esc(item.thickness)}</text>
    <rect x="${blkX}" y="0" width="${blkW}" height="${topH}" fill="#000"/>
    <text x="${blkX + blkW/2}" y="${topH/2 + 4}" text-anchor="middle" fill="#fff" font-size="10" font-weight="900">${esc(item.height || '')}</text>
    <line x1="${letterW}" y1="${topH}" x2="${W}" y2="${topH}" stroke="#000" stroke-width="0.3"/>
    <text x="${W/2}" y="${botY + botH/2 + 2.5}" text-anchor="middle" fill="#000" font-size="7">${esc(item.manufacturer)}</text>
  </svg>`;
}

let parsedData = [];

$('parseBtn').onclick = function() {
  showError('');
  const text = $('paste').value;
  if (!text.trim()) { showError('Вставьте таблицу из Excel'); return; }

  parsedData = parseTable(text);
  if (!parsedData.length) { showError('Не удалось распознать строки. Формат: Тип \\t Толщина \\t Заточка \\t Высота \\t Производитель \\t Количество'); return; }

  const tbody = $('tbody');
  tbody.innerHTML = '';
  let totalLabels = 0;
  for (const row of parsedData) {
    totalLabels += row.qty;
    const tr = document.createElement('tr');
    tr.innerHTML = `<td><b>${row.type}</b></td><td>${row.thickness}</td><td>${row.edge}</td><td>${row.height || '—'}</td><td>${row.manufacturer}</td><td>${row.qty}</td>`;
    tbody.appendChild(tr);
  }
  $('parsedInfo').hidden = false;
  $('stats').innerHTML = `<span class="stat">${parsedData.length} типов · ${totalLabels} этикеток</span>`;

  const preview = $('preview');
  preview.hidden = false;
  preview.innerHTML = '<span class="result-label">Примеры этикеток</span>';
  const shown = new Set();
  for (const row of parsedData) {
    if (shown.has(row.type)) continue;
    shown.add(row.type);
    const card = document.createElement('div');
    card.className = 'label-card';
    card.innerHTML = `<div class="label-svg-wrap">${renderLabelSVG(row)}</div><div class="info"><b>${row.type}</b> · ${row.thickness} · ${row.edge} · ${row.height || '—'} · ${row.manufacturer} · ${row.qty} шт</div>`;
    preview.appendChild(card);
  }

  $('pdfBtn').disabled = false;
};

function svgToCanvas(svgStr, w, h) {
  return new Promise((resolve, reject) => {
    const blob = new Blob([svgStr], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      const scale = 4;
      canvas.width = w * scale;
      canvas.height = h * scale;
      const ctx = canvas.getContext('2d');
      ctx.scale(scale, scale);
      ctx.drawImage(img, 0, 0, w, h);
      URL.revokeObjectURL(url);
      resolve(canvas);
    };
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('SVG render failed')); };
    img.src = url;
  });
}

async function generatePDF() {
  const { jsPDF } = window.jspdf || {};
  if (!jsPDF) { alert('PDF библиотека не загружена'); return; }

  const doc = new jsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });
  const pageW = 210, pageH = 297;
  const labelW = 80, labelH = 24;
  const cols = Math.floor(pageW / labelW);
  const rows = Math.floor(pageH / labelH);
  const labelsPerPage = cols * rows;
  const marginX = (pageW - cols * labelW) / 2;
  const marginY = (pageH - rows * labelH) / 2;

  const allLabels = [];
  for (const item of parsedData) {
    for (let i = 0; i < item.qty; i++) allLabels.push(item);
  }

  let labelIdx = 0;

  while (labelIdx < allLabels.length) {
    if (labelIdx > 0) doc.addPage();

    // Cut marks — crosses at every grid intersection
    doc.setDrawColor(0);
    doc.setLineWidth(0.15);
    const m = 3;
    for (let r = 0; r <= rows; r++) {
      for (let c = 0; c <= cols; c++) {
        const x = marginX + c * labelW;
        const y = marginY + r * labelH;
        doc.line(x - m/2, y, x + m/2, y);
        doc.line(x, y - m/2, x, y + m/2);
      }
    }

    // Render labels as canvas images
    const renderBatch = [];
    for (let i = 0; i < labelsPerPage && labelIdx + i < allLabels.length; i++) {
      renderBatch.push({ idx: i, item: allLabels[labelIdx + i] });
    }

    const canvases = await Promise.all(
      renderBatch.map(async ({ idx, item }) => {
        const svg = renderLabelSVG(item);
        const c = await svgToCanvas(svg, labelW * 10, labelH * 10);
        return { idx, canvas: c };
      })
    );

    for (const { idx, canvas } of canvases) {
      const col = idx % cols;
      const row = Math.floor(idx / cols);
      const x = marginX + col * labelW;
      const y = marginY + row * labelH;
      const dataUrl = canvas.toDataURL('image/png');
      doc.addImage(dataUrl, 'PNG', x, y, labelW, labelH);
      labelIdx++;
    }
  }

  doc.save('etiketki-24x80.pdf');
}

$('pdfBtn').onclick = generatePDF;

$('paste').addEventListener('paste', function() {
  setTimeout(() => { $('parseBtn').click(); }, 100);
});
</script>
</body>
</html>
