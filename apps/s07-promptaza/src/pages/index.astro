---
import pdb from '../../../../packages/datasets/prompts.json';
const SITE = 'https://promptaza.ru';
const title = 'Промпты для нейросетей: каталог + сравнение ИИ | promptaza.ru';
const desc = 'Каталог промптов: код, тексты, маркетинг, учёба. Копирование в 1 клик. Сравнение ChatGPT, Claude, Gemini, DeepSeek, GigaChat + калькулятор цены API.';
const cats = [['kod','Код'],['tekst','Тексты'],['marketing','Маркетинг'],['seo','SEO'],['ucheba','Учёба'],['rabota','Работа'],['perevod','Перевод'],['analitika','Аналитика'],['idei','Идеи'],['povsednev','Быт']];
const faqs = [
  { q: 'Как пользоваться промптом?', a: 'Нажмите «Копировать», вставьте в ChatGPT/Claude/Gemini, замените текст в [скобках] своими данными.' },
  { q: 'Какая нейросеть лучше для кода?', a: 'Claude Sonnet и DeepSeek — топ по коду, GPT-4o универсален. Подробнее в сравнении.' },
  { q: 'Какая нейросеть доступна в России?', a: 'Официально и на русском: GigaChat и YandexGPT. Остальные — через VPN, другую страну или посредников.' },
  { q: 'Что дешевле для API?', a: 'DeepSeek и Gemini Flash — копейки. Точную цену под свой объём посчитайте в калькуляторе API.' },
  { q: 'Почему ответы слабые?', a: 'Дайте контекст, формат и пример. Формула: роль + задача + данные + формат + ограничения.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const siteJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'promptaza.ru', url: SITE, inLanguage: 'ru' });
const pageJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE + '/', inLanguage: 'ru', dateModified: '2026-09-09', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#tldr'] } });
---
<!doctype html>
<html lang="ru">
<head>
<script is:inline src="/theme-head.js"></script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={SITE + '/'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:type" content="website" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/json" title="Данные сайта для ИИ" href="/api/data.json" />
<link rel="stylesheet" href="/_s555.css?v=1" />
<script type="application/ld+json" set:html={faqJson}></script>
<script type="application/ld+json" set:html={siteJson}></script>
<script type="application/ld+json" set:html={pageJson}></script>
<!-- METRIKA: вставить код счётчика promptaza.ru -->
<script is:inline src="/theme.js" defer></script></head>
<body><div class="bg-field" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
<header class="site"><div class="wrap"><nav><a class="brand" href="/" aria-label="промптаза — на главную"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><path d="M7 8h18v13H16l-5 4v-4H7Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><circle cx="12" cy="14" r="1.4" fill="var(--accent)"/><circle cx="16.5" cy="14" r="1.4" fill="var(--accent)"/><circle cx="21" cy="14" r="1.4" fill="var(--accent)"/></svg><span>промптаза<small>.ru</small></span></a><button class="burger" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="Меню"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path class="l1" d="M2 5h16"/><path class="l2" d="M2 10h16"/><path class="l3" d="M2 15h16"/></svg></button><div class="nav-links" id="navlinks"><a href="/" aria-current="page">Промпты</a><a href="/sravnenie">Сравнение ИИ</a><a href="/api">Цены API</a><button id="ttheme" class="tbtn" type="button" aria-label="Тёмная тема" title="Тёмная тема">◐</button></div></nav></div></header>
<main class="wrap">
<section class="hero">
<p class="eyebrow">Каталог промптов</p>
<h1>Промпты для нейросетей</h1>
<p>{pdb.prompts.length} шаблонов: код, тексты, маркетинг, учёба. Копирование в 1 клик, свои данные — в [скобках].</p>
</section>
<div class="answer" id="tldr"><b>Формула сильного промпта:</b> роль + задача + данные + формат + ограничения. Пример: «Ты редактор. Сожми [текст] в 3 раза тезисами, сохранив все цифры».</div>
<section class="calc" aria-label="Фильтр промптов">
<div class="calc-layout">
<div class="calc-fields">
<label>Поиск <input id="q" type="search" placeholder="Например: резюме или SQL" /></label>
<label>Категория <select id="cat"><option value="">Все</option>{cats.map(c => (<option value={c[0]}>{c[1]}</option>))}</select></label>
</div>
<aside class="calc-side"><span class="result-label">Найдено</span><div class="result" id="count">—</div></aside>
</div>
</section>
<div class="cards" id="list" style="margin-top:16px"></div>
<h2>Разделы</h2>
<div class="cards">
<a class="card" href="/sravnenie"><h3>Сравнение нейросетей</h3><p>ChatGPT, Claude, Gemini, DeepSeek, GigaChat: задачи, цены, доступность.</p></a>
<a class="card" href="/api"><h3>Калькулятор API</h3><p>Цена под ваш объём токенов: ввод + вывод.</p></a>
</div>
<h2>Частые вопросы</h2>
<div class="faq">{faqs.map(f => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
</main>
<footer class="site"><div class="wrap"><div class="fgrid"><div><h3>promptaza.ru</h3><p>Каталог промптов и сравнение ИИ. Цены API ориентировочные. Обновлено 2026-09-09.</p></div><div><h3>Каталог</h3><ul><li><a href="/">Все промпты</a></li><li><a href="/sravnenie">Сравнение ИИ</a></li><li><a href="/api">Цены API</a></li></ul></div></div></div></footer>
<div class="cookies" id="cookies" hidden><div class="wrap"><p>Мы не собираем ваши данные и не ставим собственные куки. Для статистики используем Яндекс.Метрику — она может использовать свои куки. <button class="btn" id="cookiesOk" type="button">Понятно</button></p></div></div>
<script define:vars={{ pdb }}>
const $=id=>document.getElementById(id);
const DB=pdb.prompts;
function render(){const q=$('q').value.toLowerCase(),c=$('cat').value;
 const items=DB.filter(p=>(!c||p.c===c)&&(!q||(p.t+' '+p.p).toLowerCase().includes(q)));
 $('count').textContent=items.length+' шт.';
 $('list').innerHTML=items.map((p,i)=>`<div class="card"><h3>${p.t}</h3><p>${p.p}</p><p><button class="btn ghost" data-i="${DB.indexOf(p)}" type="button">Копировать</button></p></div>`).join('')||'<p>Ничего не найдено. Попробуйте другой запрос.</p>';
 document.querySelectorAll('#list [data-i]').forEach(b=>b.onclick=async()=>{try{await navigator.clipboard.writeText(DB[+b.dataset.i].p);b.textContent='Скопировано';setTimeout(()=>b.textContent='Копировать',1200);try{window.s555ev&&s555ev('copy_prompt',{})}catch(e){}}catch(e){}});}
$('q').addEventListener('input',render);$('cat').addEventListener('change',render);
(function(){const q=new URLSearchParams(location.search);if(q.get('q'))$('q').value=q.get('q');if(q.get('cat'))$('cat').value=q.get('cat');render()})();
(function(){const c=$('cookies');let ok=null;try{ok=localStorage.getItem('s555cookies')}catch(e){} if(!ok&&c)c.hidden=false;
 const b=$('cookiesOk');if(b)b.onclick=()=>{try{localStorage.setItem('s555cookies','1')}catch(e){} if(c)c.hidden=true;};})();
</script>
</body>
</html>
