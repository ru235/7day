<script>const $=id=>document.getElementById(id);const M=[{"api":true,"code":4,"img":5,"name":"ChatGPT (GPT-4o)","out":10,"price":"подписка $20/мес","ru":"VPN/другая страна","text":5,"in":2.5},{"api":true,"code":4,"img":1,"name":"GPT-4o mini","out":0.6,"price":"дешёвый","ru":"VPN/другая страна","text":4,"in":0.15},{"api":true,"code":5,"img":1,"name":"Claude Sonnet","out":15,"price":"подписка $20/мес","ru":"официально нет","text":5,"in":3},{"api":true,"code":4,"img":1,"name":"Claude Haiku","out":1.25,"price":"дешёвый","ru":"официально нет","text":4,"in":0.25},{"api":true,"code":4,"img":2,"name":"Gemini Pro","out":10,"price":"бесплатный лимит щедрый","ru":"VPN/другая страна","text":5,"in":1.25},{"api":true,"code":3,"img":1,"name":"Gemini Flash","out":0.3,"price":"бесплатный лимит","ru":"VPN/другая страна","text":4,"in":0.075},{"api":true,"code":5,"img":1,"name":"DeepSeek","out":1.1,"price":"очень дёшево","ru":"доступен","text":4,"in":0.27}];M.forEach(m=>{const o=document.createElement("option");o.value=m.name;o.textContent=m.name+" ($"+m.in+"/$"+m.out+")";$("am").appendChild(o)});$("ago").onclick=()=>{const m=M.find(x=>x.name===$("am").value);if(!m)return;const qi=+$("ai").value||0,qo=+$("ao").value||0,n=+$("an").value||1;const per=(qi*m.in+qo*m.out)/1000, mon=per*n;$("aout").innerHTML="Запрос: <b>$"+per.toFixed(4)+"</b> (≈ "+(per*90).toFixed(1)+" ₽)<br>Месяц ("+n+"): <b>$"+mon.toFixed(2)+"</b> (≈ "+(mon*90).toFixed(0)+" ₽)";try{window.s555ev&&s555ev("calc_run",{m:m.name})}catch(e){}};$("ago").click();</script>
