---
const SITE = 'https://formatjson.ru';
const title = 'Formatear JSON Online — Validador, YAML, Base64 | formatjson.ru';
const desc = 'Convertidor JSON gratuito: formateo, minificación, validación, JSON ↔ YAML, Base64 y codificación URL. Funciona en el navegador, sin enviar datos al servidor.';
const faqs = [
  { q: '¿Cómo validar JSON?', a: 'Pega el texto y haz clic en “Formatear” — resaltamos la línea y posición del error (Unexpected token, trailing comma, bracket sin cerrar). Corrige y formatea de nuevo.' },
  { q: '¿Formatear vs minificar?', a: 'Formatear añade saltos y 2 o 4 espacios para leer. Minificar elimina espacios y saltos — útil para código o API.' },
  { q: '¿Cómo convertir JSON a YAML?', a: 'Haz clic en “JSON → YAML”. Soportamos objetos, arrays, strings, números, boolean y null. Inverso con “YAML → JSON”. Anchors complejos no soportados.' },
  { q: '¿Base64 y cirílico?', a: 'Codificamos en UTF-8, por lo que cirílico, emoji y saltos se conservan. Decodificar usa TextDecoder — secuencias rotas se muestran como error.' },
  { q: '¿Se envían los datos?', a: 'No. Todo se calcula en el navegador. Historial de 20 operaciones en localStorage. Borra con “Limpiar”.' },
  { q: '¿Qué es la codificación URL?', a: 'Reemplaza cirílico y símbolos por %XX para la barra de direcciones. Decodificar es lo inverso. Útil para query params.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const siteJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'formatjson.ru', url: SITE, inLanguage: 'es' });
const pageJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE + '/es/', inLanguage: 'es', dateModified: '2026-09-10', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#tldr'] } });
const howtoJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'HowTo', name: 'Cómo formatear JSON', inLanguage: 'es', step: [{ '@type': 'HowToStep', name: 'Pega JSON', text: 'Copia el JSON en el campo izquierdo.' }, { '@type': 'HowToStep', name: 'Haz clic en Formatear', text: 'Elige indentación 2 o 4 espacios y haz clic.' }, { '@type': 'HowToStep', name: 'Copia resultado', text: 'Copia, descarga como archivo o comparte el enlace.' }] });
---
