<div class="calc-layout">
<div class="calc-fields">
<label>Вход <textarea id="inp" rows="10" placeholder='{"name":"Иван","age":30,"tags":["dev","json"]}' style="font-family:var(--mono);font-size:14px;resize:vertical;min-height:160px;padding:12px 14px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg);color:var(--fg)"></textarea></label>
