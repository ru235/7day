<span class="result-label">Результат</span>
<textarea id="out" rows="12" readonly placeholder="Результат появится здесь…" style="font-family:var(--mono);font-size:14px;resize:vertical;min-height:220px;padding:12px 14px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg);color:var(--fg);white-space:pre;overflow:auto"></textarea>
