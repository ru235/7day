---
const SITE = 'https://formatjson.ru';
const title = 'Форматировать JSON онлайн — валидатор, YAML, Base64 | formatjson.ru';
const desc = 'Бесплатный конвертер JSON: форматирование, минификация, валидация, JSON ↔ YAML, Base64 и URL-кодирование. Работает в браузере, без отправки данных на сервер. Копирование, шаринг и печать.';
const faqs = [
  { q: 'Как проверить JSON на ошибки?', a: 'Вставьте текст и нажмите «Форматировать» — подсветим строку и позицию ошибки (Unexpected token, trailing comma, незакрытая скобка). Исправьте и отформатируйте снова.' },
  { q: 'Чем форматирование отличается от минификации?', a: 'Форматирование расставляет переносы и отступы 2 или 4 пробела для чтения. Минификация убирает все пробелы и переносы — удобно для вставки в код или API.' },
  { q: 'Как конвертировать JSON в YAML?', a: 'Нажмите «JSON → YAML». Поддерживаем объекты, массивы, строки, числа, boolean и null. Обратно — «YAML → JSON» с проверкой. Сложные YAML-якоря не поддерживаем.' },
  { q: 'Base64 — как кодировать кириллицу?', a: 'Кодируем в UTF-8, поэтому русский текст, эмодзи и переносы сохраняются. Для декодирования используем TextDecoder — битые последовательности покажем как ошибку.' },
  { q: 'Данные куда-то отправляются?', a: 'Нет. Всё считается в браузере. История последних 20 операций хранится в localStorage и никуда не уходит. Очищается кнопкой «Очистить».' },
  { q: 'Что такое URL-кодирование?', a: 'Заменяет кириллицу и спецсимволы на %XX для вставки в адресную строку. Декодирование — обратно. Полезно для query-параметров и отладки запросов.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const siteJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'formatjson.ru', url: SITE, inLanguage: 'ru' });
const pageJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE + '/', inLanguage: 'ru', dateModified: '2026-09-10', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#tldr'] } });
const howtoJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'HowTo', name: 'Как отформатировать JSON', inLanguage: 'ru', step: [{ '@type': 'HowToStep', name: 'Вставьте JSON', text: 'Скопируйте исходный JSON в левое поле.' }, { '@type': 'HowToStep', name: 'Нажмите Форматировать', text: 'Выберите отступ 2 или 4 пробела и нажмите кнопку.' }, { '@type': 'HowToStep', name: 'Скопируйте результат', text: 'Скопируйте, скачайте как файл или поделитесь ссылкой.' }] });
