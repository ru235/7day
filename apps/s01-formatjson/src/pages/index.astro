<label style="font-size:14px;color:var(--muted)">Отступ <select id="indent" style="padding:8px 10px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg);color:var(--fg)"><option value="2">2 пробела</option><option value="4">4 пробела</option><option value="tab">Tab</option></select></label>
<label style="display:flex;gap:6px;align-items:center;font-size:14px;color:var(--muted)"><input id="sort" type="checkbox" /> Сортировать ключи</label>
</div>
<div style="display:flex;gap:12px;flex-wrap:wrap">
<button class="btn" id="fmt">Форматировать</button>
<button class="btn ghost" id="mini">Минифицировать</button>
<button class="btn ghost" id="validate">Проверить</button>
</div>
<div style="display:flex;gap:12px;flex-wrap:wrap">
<button class="btn ghost" id="j2y">JSON → YAML</button>
<button class="btn ghost" id="y2j">YAML → JSON</button>
</div>
<div style="display:flex;gap:14px;flex-wrap:wrap">
<button class="btn ghost" id="b64e">Base64 ↑</button>
<button class="btn ghost" id="b64d">Base64 ↓</button>
<button class="btn ghost" id="urlE">URL ↑</button>
<button class="btn ghost" id="urlD">URL ↓</button>
</div>
<div style="display:flex;gap:10px;flex-wrap:wrap">
<button class="btn ghost" id="copyOut">Копировать</button>
<button class="btn ghost" id="download">Скачать .json</button>
<button class="btn ghost" id="clear">Очистить</button>
<button class="btn ghost" id="share">Поделиться</button>
</div>
