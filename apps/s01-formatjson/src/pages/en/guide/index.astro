---
const SITE = 'https://formatjson.ru';
const title = 'JSON Guide: Errors, Quotes, Commas, Escaping | formatjson.ru';
const desc = 'Common JSON mistakes: trailing comma, single quotes, comments, unescaped line breaks. How to format, minify and validate.';
const faqs = [
  { q: 'Why “Unexpected token”?', a: 'Extra comma at end of array/object, single quotes or unclosed bracket. Remove comma, replace \' with ".' },
  { q: 'Are comments allowed?', a: 'Pure JSON does not support // and /* */. Remove comments before validation or use JSONC.' },
  { q: 'How to escape line breaks?', a: 'Inside strings use \\n, \\t, \\". Our formatter escapes automatically.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
