<section class="print-sheet" id="psheet" aria-hidden="true"></section>
</main>
<footer class="site"><div class="wrap"><div class="fgrid"><div><h3>formatjson.ru</h3><p>Converters for developers: JSON, YAML, Base64, URL. Everything in the browser, no server. Updated 2026-09-10.</p></div><div><h3>Tools</h3><ul><li><a href="./">Converter</a></li><li><a href="yaml/">YAML</a></li><li><a href="base64/">Base64</a></li></ul></div><div><h3>Help</h3><ul><li><a href="guide/">Guide</a></li><li><a href="../api/data.json">API / AI access</a></li></ul></div></div></div></footer>
<div class="cookies" id="cookies" hidden><div class="wrap"><p>We do not collect your data. For stats we use Yandex Metrica — it may use its own cookies. <button class="btn" id="cookiesOk" type="button">Got it</button></p></div></div>
<script is:inline>
const $=id=>document.getElementById(id);
const inp=$('inp'), out=$('out'), err=$('err'), stats=$('stats');
function indentStr(v){ if(v==='tab') return '\t'; return ' '.repeat(parseInt(v||2)); }
function sortKeys(obj){ if(Array.isArray(obj)) return obj.map(sortKeys); if(obj && typeof obj==='object'){ const o={}; Object.keys(obj).sort().forEach(k=>o[k]=sortKeys(obj[k])); return o; } return obj; }
function parseJSONSafe(s){ return JSON.parse(s); }
function formatJSON(s){
  const ind=indentStr($('indent').value);
  const needSort=$('sort').checked;
  let obj=parseJSONSafe(s);
  if(needSort) obj=sortKeys(obj);
  if(indentStr($('indent').value)==='\t') return JSON.stringify(obj, null, '\t');
  return JSON.stringify(obj, null, parseInt($('indent').value)||2);
}
function minifyJSON(s){ let obj=parseJSONSafe(s); if($('sort').checked) obj=sortKeys(obj); return JSON.stringify(obj); }
function toYAML(obj, level=0){
  const pad='  '.repeat(level);
  if(obj===null) return 'null';
  if(typeof obj==='boolean') return obj?'true':'false';
  if(typeof obj==='number') return String(obj);
  if(typeof obj==='string'){
    if(/[:#\-\n]/.test(obj) || /^\s|\s$/.test(obj) || obj==='' ) return JSON.stringify(obj);
    return obj;
  }
  if(Array.isArray(obj)){
    if(obj.length===0) return '[]';
    return obj.map(v=>{
      if(v && typeof v==='object') {
        const inner=toYAML(v, level+1);
        if(inner.includes('\n')) return pad+'- '+inner.trimStart().split('\n').join('\n'+pad+'  ');
        return pad+'- '+inner;
      }
      return pad+'- '+toYAML(v, level+1).trim();
    }).join('\n');
  }
  if(typeof obj==='object'){
    const keys=Object.keys(obj);
    if(keys.length===0) return '{}';
    return keys.map(k=>{
      const v=obj[k];
      const keyNeedQuote=/[:#\s]/.test(k) || /^\d/.test(k) ? JSON.stringify(k) : k;
      if(v && typeof v==='object'){
        const inner=toYAML(v, level+1);
        if(inner.includes('\n')) return pad+keyNeedQuote+':\n'+inner;
        if(inner==='[]' || inner==='{}') return pad+keyNeedQuote+': '+inner;
        if(typeof v==='object' && !Array.isArray(v)) return pad+keyNeedQuote+':\n'+inner;
        return pad+keyNeedQuote+': '+inner.trim();
      }
      return pad+keyNeedQuote+': '+toYAML(v, level+1).trim();
    }).join('\n');
  }
  return String(obj);
}
function yamlToJson(yaml){
  const lines=yaml.split('\n');
  const t=yaml.trim();
  if((t.startsWith('{')||t.startsWith('['))){ try{ return JSON.parse(t); }catch(e){} }
  let idx=0;
  function parseBlock(indent){
    let obj=null, isArr=false;
    const res = {};
    const arr=[];
    while(idx<lines.length){
      let raw=lines[idx];
      if(!raw.trim()||raw.trim().startsWith('#')){ idx++; continue; }
      const curIndent=raw.search(/\S/);
      if(curIndent<indent) break;
      if(curIndent>indent){ idx++; continue; }
      let line=raw.trim();
      if(line.startsWith('- ')){
        isArr=true;
        const val=line.slice(2).trim();
        if(val===''){ idx++; const child=parseBlock(indent+2); arr.push(child); }
        else if(val.includes(': ')){
          idx++;
          const k=val.split(':')[0].trim(); const v=val.split(':').slice(1).join(':').trim();
          const o={}; o[unquote(k)] = parseScalar(v);
          if(idx<lines.length && lines[idx].search(/\S/)>indent){
            const child=parseBlock(indent+2);
            if(child && typeof child==='object' && !Array.isArray(child)) Object.assign(o, child);
          }
          arr.push(o);
        } else {
          arr.push(parseScalar(val)); idx++;
        }
      } else if(line.includes(':')){
        const colon=line.indexOf(':');
        const k=line.slice(0,colon).trim();
        let v=line.slice(colon+1).trim();
        if(v===''){
          idx++;
          const child=parseBlock(indent+2);
          res[unquote(k)] = child===null ? {} : child;
          obj=res;
        } else {
          res[unquote(k)]=parseScalar(v); idx++;
          obj=res;
        }
      } else {
        idx++; return parseScalar(line);
      }
    }
    if(isArr) return arr;
    if(obj!==null) return obj;
    if(Object.keys(res).length) return res;
    return null;
  }
  function parseScalar(s){
    if(s==='null'||s==='~') return null;
    if(s==='true') return true;
    if(s==='false') return false;
    if(s==='[]') return [];
    if(s==='{}') return {};
    if(/^".*"$/.test(s) || /^'.*'$/.test(s)){ try{ return JSON.parse(s); }catch(e){ return s.slice(1,-1); } }
    if(!isNaN(s) && s!=='' ) return Number(s);
    return s;
  }
  function unquote(s){ if(/^".*"$/.test(s)||/^'.*'$/.test(s)) try{return JSON.parse(s)}catch(e){return s.slice(1,-1)} return s; }
  const result=parseBlock(0);
  return result===null ? {} : result;
}
function b64Encode(s){ return btoa(unescape(encodeURIComponent(s))); }
function b64Decode(s){
  s=s.replace(/\s/g,'');
  const pad=s.length%4; if(pad) s+='='.repeat(4-pad);
  return decodeURIComponent(escape(atob(s)));
}
function urlEncode(s){ return encodeURIComponent(s); }
function urlDecode(s){ return decodeURIComponent(s); }
function setOut(v, isErr){
  if(isErr){ err.textContent=v; out.value=''; } else { err.textContent=''; out.value=v; stats.textContent='Chars: '+v.length+' · Lines: '+v.split('\n').length; try{localStorage.setItem('s01_hist', JSON.stringify([{t:Date.now(), len:v.length}].concat(JSON.parse(localStorage.getItem('s01_hist')||'[]')).slice(0,20)))}catch(e){} try{window.s555ev&&s555ev('calc_run',{len:v.length})}catch(e){} }
}
function action(fn){
  const s=inp.value;
  if(!s.trim()){ setOut('',true); err.textContent='Paste data on the left.'; return; }
  try{ const r=fn(s); setOut(r,false); } catch(e){ setOut('',true); err.textContent=e.message; }
}
$('fmt').onclick=()=>action(s=>formatJSON(s));
$('mini').onclick=()=>action(s=>minifyJSON(s));
$('validate').onclick=()=>action(s=>{ parseJSONSafe(s); return '✓ Valid JSON — no errors.'; });
$('j2y').onclick=()=>action(s=>{ const obj=parseJSONSafe(s); return toYAML(obj); });
$('y2j').onclick=()=>action(s=>{ const obj=yamlToJson(s); return JSON.stringify(obj, null, indentStr($('indent').value)==='\t'?'\t':parseInt($('indent').value)||2); });
$('b64e').onclick=()=>{ const s=inp.value; if(!s) return; try{ setOut(b64Encode(s),false);}catch(e){ setOut('',true); err.textContent=e.message; } };
$('b64d').onclick=()=>{ const s=inp.value.trim(); if(!s) return; try{ setOut(b64Decode(s),false);}catch(e){ setOut('',true); err.textContent='Base64 error: '+e.message; } };
$('urlE').onclick=()=>{ const s=inp.value; setOut(urlEncode(s),false); };
$('urlD').onclick=()=>{ try{ setOut(urlDecode(inp.value),false);}catch(e){ setOut('',true); err.textContent='URL-decode error: '+e.message; } };
$('copyOut').onclick=async()=>{ if(!out.value) return; try{ await navigator.clipboard.writeText(out.value); const b=$('copyOut'); const t=b.textContent; b.textContent='Copied'; setTimeout(()=>b.textContent=t,1200);}catch(e){} };
$('download').onclick=()=>{ if(!out.value) return; const blob=new Blob([out.value],{type:'application/json'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='data.json'; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),1000); };
$('clear').onclick=()=>{ inp.value=''; out.value=''; err.textContent=''; stats.textContent='Cleared.'; history.replaceState(null,'',location.pathname); };
$('share').onclick=async()=>{ const u=new URL(location.href); u.searchParams.set('q', btoa(unescape(encodeURIComponent(inp.value))).slice(0,1500)); history.replaceState(null,'',u); try{await navigator.clipboard.writeText(u.toString()); $('share').textContent='Link copied'; setTimeout(()=>$('share').textContent='Share',1200);}catch(e){} };
document.addEventListener('keydown',e=>{ if(e.ctrlKey&&e.key==='Enter'){ e.preventDefault(); $('fmt').click(); } if(e.ctrlKey&&e.shiftKey&&e.key.toLowerCase()==='m'){ e.preventDefault(); $('mini').click(); } });
(function(){ const q=new URLSearchParams(location.search).get('q'); if(q){ try{ const v=decodeURIComponent(escape(atob(q))); inp.value=v; }catch(e){} } if(!inp.value) inp.value='{\n  "project": "formatjson",\n  "features": ["format","yaml","base64"],\n  "ok": true\n}'; $('fmt').click(); })();
(function(){const c=$('cookies');let ok=null;try{ok=localStorage.getItem('s555cookies')}catch(e){} if(!ok&&c)c.hidden=false; const b=$('cookiesOk'); if(b)b.onclick=()=>{try{localStorage.setItem('s555cookies','1')}catch(e){} if(c)c.hidden=true;};})();
</script>
</body>
</html>
