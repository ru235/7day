<tr><td><code>hello world</code></td><td>Base64 ↑</td><td><code>aGVsbG8gd29ybGQ=</code></td></tr>
<tr><td><code>hello world=1&amp;x=2</code></td><td>URL ↑</td><td><code>hello%20world%3D1%26x%3D2</code></td></tr>
