---
const SITE = 'https://formatjson.ru';
const title = 'Format JSON Online — Validator, YAML, Base64 | formatjson.ru';
const desc = 'Free JSON converter: formatting, minification, validation, JSON ↔ YAML, Base64 and URL encoding. Runs in the browser, no data sent to server. Copy, download and share.';
const faqs = [
  { q: 'How to validate JSON?', a: 'Paste the text and click “Format” — we highlight the line and error position (Unexpected token, trailing comma, unclosed bracket). Fix and format again.' },
  { q: 'Format vs minify?', a: 'Format adds line breaks and 2 or 4 spaces for readability. Minify removes all spaces and line breaks — handy for code or API payloads.' },
  { q: 'How to convert JSON to YAML?', a: 'Click “JSON → YAML”. We support objects, arrays, strings, numbers, boolean and null. Reverse with “YAML → JSON”. Complex YAML anchors are not supported.' },
  { q: 'Base64 and Cyrillic?', a: 'We encode in UTF-8, so Cyrillic, emoji and line breaks are preserved. Decoding uses TextDecoder — broken sequences are shown as errors.' },
  { q: 'Is data sent anywhere?', a: 'No. Everything runs in the browser. Last 20 operations are stored in localStorage locally. Clear with the “Clear” button.' },
  { q: 'What is URL encoding?', a: 'It replaces Cyrillic and special characters with %XX for the address bar. Decoding is the reverse. Useful for query params and request debugging.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const siteJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'formatjson.ru', url: SITE, inLanguage: 'en' });
const pageJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE + '/en/', inLanguage: 'en', dateModified: '2026-09-10', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#tldr'] } });
const howtoJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'HowTo', name: 'How to format JSON', inLanguage: 'en', step: [{ '@type': 'HowToStep', name: 'Paste JSON', text: 'Copy the source JSON into the left field.' }, { '@type': 'HowToStep', name: 'Click Format', text: 'Choose indent 2 or 4 spaces and click the button.' }, { '@type': 'HowToStep', name: 'Copy result', text: 'Copy, download as file or share the link.' }] });
---
