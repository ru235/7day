---
const SITE = 'https://formatjson.ru';
const title = 'Base64 Encode & Decode Online — UTF-8 | formatjson.ru';
const desc = 'Base64 converter: encode text and JSON to Base64 and back. UTF-8 support, Cyrillic, line breaks, validation.';
const faqs = [
  { q: 'Why Base64?', a: 'To send binary data as text — in JSON, URL, email. Encodes 3 bytes into 4 chars A-Za-z0-9+/.' },
  { q: 'Cyrillic broken?', a: 'No, we encode via UTF-8. “hello” → aGVsbG8=, “privet” stays correct. Decoding reverses it.' },
  { q: 'Are line breaks important?', a: 'Encoding preserves them. Decoding ignores spaces and line breaks.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
---
<!doctype html><html lang="en"><head><script is:inline src="../../theme-head.js"></script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title}</title><meta name="description" content={desc} /><link rel="canonical" href={SITE + '/en/base64/'} /><link rel="alternate" hreflang="ru" href={SITE + '/base64/'} /><link rel="alternate" hreflang="en" href={SITE + '/en/base64/'} /><link rel="alternate" hreflang="es" href={SITE + '/es/base64/'} /><link rel="alternate" hreflang="x-default" href={SITE + '/base64/'} /><meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:type" content="article" /><link rel="stylesheet" href="../../_s555.css?v=5" /><script type="application/ld+json" set:html={faqJson}></script><script is:inline src="../../theme.js" defer></script></head>
<body><div class="bg-field" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
<header class="site"><div class="wrap"><nav><a class="brand" href="../"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><rect x="6" y="7" width="20" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M9 12h6M9 16h6M9 20h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="20" cy="14.5" r="2.2" fill="var(--accent)"/></svg><span>formatjson<small>.ru</small></span></a><button class="burger" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="Menu"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path class="l1" d="M2 5h16"/><path class="l2" d="M2 10h16"/><path class="l3" d="M2 15h16"/></svg></button><div class="nav-links" id="navlinks"><a href="../">Converter</a><a href="../yaml/">YAML</a><a href="./" aria-current="page">Base64</a><a href="../guide/">Guide</a><span style="display:inline-flex;align-items:center;gap:6px;margin-left:6px;padding:4px 8px;border:1px solid var(--line);border-radius:20px;background:var(--card)"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20A15 15 0 0 1 12 2z" stroke="currentColor" stroke-width="1.2"/><path d="M4 6h16M4 18h16" stroke="currentColor" stroke-width="1" opacity="0.6"/></svg><a href="../../base64/" style="color:var(--brand);font-weight:600;font-size:12px;text-decoration:none">RU</a><span style="color:var(--fg);font-weight:700;font-size:12px">EN</span><a href="../../es/base64/" style="color:var(--brand);font-weight:600;font-size:12px;text-decoration:none">ES</a></span><button id="ttheme" class="tbtn" type="button" aria-label="Dark theme" title="Dark theme">◐</button></div></nav></div></header>
<main class="wrap"><nav class="crumbs"><a href="../">Home</a> / <span aria-current="page">Base64</span></nav>
<h1>Base64 — Encode & Decode</h1>
<div class="answer"><b>TL;DR:</b> Base64 turns any text (including JSON and Unicode) into safe ASCII. Encoding is UTF-8, decoding is validated.</div>
<section class="calc"><div class="calc-layout"><div class="calc-fields">
<label>Input <textarea id="inp" rows="10" placeholder="hello world" style="font-family:var(--mono);font-size:14px;min-height:160px;padding:12px 14px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg);color:var(--fg)"></textarea></label>
<div style="display:flex;gap:12px;flex-wrap:wrap"><button class="btn" id="enc">Encode</button><button class="btn ghost" id="dec">Decode</button><button class="btn ghost" id="copy">Copy</button></div>
<p id="err" style="font-size:13px;color:var(--danger);min-height:18px"></p>
</div><aside class="calc-side"><span class="result-label">Result</span><textarea id="out" rows="10" readonly style="font-family:var(--mono);font-size:14px;min-height:160px;padding:12px 14px;border:1px solid var(--line);border-radius:var(--radius);background:var(--bg);color:var(--fg)"></textarea></aside></div></section>
<h2>Examples</h2><table class="data"><tr><th>Text</th><th>Base64</th></tr><tr><td>hello</td><td>aGVsbG8=</td></tr><tr><td>hello world</td><td>aGVsbG8gd29ybGQ=</td></tr><tr><td>&#123;&quot;a&quot;:1&#125;</td><td>eyJhIjoxfQ==</td></tr></table>
<h2>FAQ</h2><div class="faq">{faqs.map(f => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
<p><a href="../">← Back to converter</a></p>
</main>
<footer class="site"><div class="wrap"><div class="fgrid"><div><h3>formatjson.ru</h3><p>Base64 in the browser. Updated 2026-09-10.</p></div><div><h3>Tools</h3><ul><li><a href="../">Converter</a></li><li><a href="../yaml/">YAML</a></li></ul></div></div></div></footer>
<script>
const $=id=>document.getElementById(id);
function b64Encode(s){ return btoa(unescape(encodeURIComponent(s))); }
function b64Decode(s){ s=s.replace(/\s/g,''); const pad=s.length%4; if(pad) s+='='.repeat(4-pad); return decodeURIComponent(escape(atob(s))); }
$('enc').onclick=()=>{ try{$('out').value=b64Encode($('inp').value); $('err').textContent='';}catch(e){$('err').textContent=e.message;}};
$('dec').onclick=()=>{ try{$('out').value=b64Decode($('inp').value.trim()); $('err').textContent='';}catch(e){$('err').textContent='Base64 error: '+e.message;}};
$('copy').onclick=async()=>{ await navigator.clipboard.writeText($('out').value); };
</script></body></html>
