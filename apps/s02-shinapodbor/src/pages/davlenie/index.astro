---
const SITE = 'https://shinapodbor.ru';
const title = 'Давление в шинах: нормы и поправки | shinapodbor.ru';
const desc = 'Какое давление качать: нормы по классам авто, поправка на загрузку и трассу +0.2 атм. Недокач и перекач: износ, расход, управляемость.';
const faqs = [
  { q: 'Какое давление качать?', a: 'По табличке авто (стойка двери, лючок бака): легковые обычно 2.2–2.5 атм. Под полную загрузку и трассу добавляйте 0.2.' },
  { q: 'Чем опасен недокач?', a: 'Жрёт края протектора, растёт расход (+5–10% при −0.5 атм), шина греется и может разрушиться на скорости.' },
  { q: 'Чем опасен перекач?', a: 'Износ центра, жёсткость, хуже держак на неровностях. Небольшой перекач +0.2 для трассы — норма.' },
  { q: 'Когда мерить?', a: 'На холодную, до поездки. На горячую давление выше на 0.2–0.3 — это не повод стравливать.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const crumbs = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Главная', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Давление', item: SITE + '/davlenie' }] });
const article = JSON.stringify({ '@context': 'https://schema.org', '@type': 'Article', headline: 'Давление в шинах', description: desc, inLanguage: 'ru', datePublished: '2026-09-08', dateModified: '2026-09-08', author: { '@type': 'Organization', name: 'shinapodbor.ru' } });
