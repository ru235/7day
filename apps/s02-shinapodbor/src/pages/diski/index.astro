---
const SITE = 'https://shinapodbor.ru';
const title = 'Диски: вылет ET, разболтовка PCD, ступица DIA | shinapodbor.ru';
const desc = 'Проверка совместимости дисков: PCD обязана совпасть, вылет ET ±5–7 мм, DIA точно или кольца. Схема вылета, калькулятор.';
const faqs = [
  { q: 'Что будет при неправильном вылете?', a: 'Меньше ET — колея шире, нагрузка на подшипники и рулевое. Больше ET — диск трёт о суппорт и стойку. Допуск ±5–7 мм.' },
  { q: 'DIA больше ступицы — можно?', a: 'Да, через центровочные кольца. Меньше — нельзя, диск не сядет.' },
  { q: 'PCD 5x114.3 и 5x115 — взаимозаменяемы?', a: 'Нет. Даже 0.7 мм разницы — болты встанут криво, будет биение. Только точное совпадение.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const crumbs = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Главная', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Диски', item: SITE + '/diski' }] });
const article = JSON.stringify({ '@context': 'https://schema.org', '@type': 'Article', headline: 'Диски: вылет, разболтовка, ступица', description: desc, inLanguage: 'ru', datePublished: '2026-09-08', dateModified: '2026-09-08', author: { '@type': 'Organization', name: 'shinapodbor.ru' } });
---
<!doctype html><html lang="ru"><head><script is:inline src="/theme-head.js"></script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
