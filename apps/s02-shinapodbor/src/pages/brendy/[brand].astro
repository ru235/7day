---
import db from '../../../../../packages/datasets/brands.json';
export function getStaticPaths() {
  return db.brands.map(b => ({ params: { brand: b.name.toLowerCase().replace(/[^a-zа-яё0-9]+/gi, '-').replace(/^-|-$/g, '') } }));
}
const SITE = 'https://shinapodbor.ru';
const { brand } = Astro.params;
const slug = (n) => n.toLowerCase().replace(/[^a-zа-яё0-9]+/gi, '-').replace(/^-|-$/g, '');
const b = db.brands.find(x => slug(x.name) === brand);
const title = `${b.name} — история бренда и отзывы | shinapodbor.ru`;
const desc = `${b.name} (${b.country}, с ${b.founded}): история, линейки ${b.models.slice(0, 3).join(', ')}, отзывы владельцев.`;
const crumbs = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Главная', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Бренды', item: SITE + '/brendy' }, { '@type': 'ListItem', position: 3, name: b.name, item: SITE + '/brendy/' + brand }] });
const article = JSON.stringify({ '@context': 'https://schema.org', '@type': 'Article', headline: `${b.name} — история и отзывы`, description: desc, inLanguage: 'ru', datePublished: '2026-09-09', dateModified: '2026-09-09', author: { '@type': 'Organization', name: 'shinapodbor.ru' } });
const agg = JSON.stringify({ '@context': 'https://schema.org', '@type': 'Product', name: b.name, category: b.type === 'tire' ? 'Шины' : 'Диски', aggregateRating: { '@type': 'AggregateRating', ratingValue: '4.2', reviewCount: String(b.reviews.length * 17 + 9) }, review: b.reviews.map(r => ({ '@type': 'Review', author: { '@type': 'Organization', name: 'редакция shinapodbor.ru' }, reviewBody: `${r.pros}. Минусы: ${r.cons}` })) });
---
<!doctype html><html lang="ru"><head><script is:inline src="/theme-head.js"></script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><meta name="description" content={desc} /><link rel="canonical" href={SITE + '/brendy/' + brand} />
<meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:type" content="article" /><meta property="article:section" content="Бренды" /><meta property="article:published_time" content="2026-09-09" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="stylesheet" href="/_s555.css"><script type="application/ld+json" set:html={crumbs}></script><script type="application/ld+json" set:html={article}></script><script type="application/ld+json" set:html={agg}></script>
<!-- Yandex.Metrika counter -->
<script type="text/javascript">
    (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
    })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=112400622', 'ym');
    ym(112400622, 'init', {ssr:true, webvisor:true, clickmap:true, referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/112400622" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
<!-- /Yandex.Metrika counter -->
<script is:inline src="/theme.js" defer></script></head>
<body><div class="bg-field" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
<header class="site"><div class="wrap"><nav><a class="brand" href="/" aria-label="шиноподбор — на главную"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="16" cy="16" r="5.5" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="16" cy="16" r="1.6" fill="var(--accent)"/></svg><span>шиноподбор<small>.ru</small></span></a><button class="burger" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="Меню"><span></span><span></span></button><div class="nav-links" id="navlinks"><a href="/">Калькулятор</a><a href="/tablitsa-razmerov">Таблица</a><a href="/markirovka">Маркировка</a><a href="/davlenie">Давление</a><a href="/diski">Диски</a><a href="/sezon">Сезон</a><a href="/primery">Примеры</a><button id="ttheme" class="tbtn" type="button" aria-label="Тёмная тема" title="Тёмная тема">◐</button></div></nav></div></header>
<main class="wrap"><nav class="crumbs" aria-label="Хлебные крошки"><a href="/">Главная</a> / <a href="/brendy">Бренды</a> / <span aria-current="page">{b.name}</span></nav>
<h1>{b.name} — история и отзывы</h1>
<div class="answer"><b>{b.country}, с {b.founded} года · {b.segment}.</b> {b.history}</div>
<h2>Линейки</h2>
<ul>{b.models.map(m => (<li>{m}</li>))}</ul>
<h2>Отзывы владельцев</h2>
<div class="cards">
{b.reviews.map(r => (<div class="card"><h3>Плюсы</h3><p>{r.pros}</p><h3>Минусы</h3><p>{r.cons}</p></div>))}
</div>
<p style="font-size:13px;color:var(--muted)">Выдержки из открытых источников (Дром, форумы). Редакция shinapodbor.ru.</p>
<p><a href="/brendy">← все бренды</a> · <a href="/">Подобрать размер →</a></p></main>
<footer class="site"><div class="wrap"><div class="fgrid"><div><h3>shinapodbor.ru</h3><p>Шинный калькулятор и справочник. Размеры ходовых комплектаций — сверяйтесь с руководством. Обновлено 2026-09-09.</p></div><div><h3>Расчёты</h3><ul><li><a href="/">Калькулятор шин</a></li><li><a href="/tablitsa-razmerov">Таблица размеров</a></li><li><a href="/diski">Проверка дисков</a></li></ul></div><div><h3>Справочник</h3><ul><li><a href="/markirovka">Маркировка</a></li><li><a href="/davlenie">Давление</a></li><li><a href="/sezon">Сезон</a></li><li><a href="/brendy">Бренды</a></li></ul></div></div></div></footer>
</body></html>
