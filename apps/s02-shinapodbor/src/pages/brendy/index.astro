---
import db from '../../../../../packages/datasets/brands.json';
const SITE = 'https://shinapodbor.ru';
const title = 'Производители шин и дисков: истории и отзывы | shinapodbor.ru';
const desc = '28 брендов: Nokian, Michelin, Bridgestone, K&K, SKAD, BBS и другие. История, линейки, отзывы владельцев.';
const crumbs = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Главная', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Бренды', item: SITE + '/brendy' }] });
const slug = (n) => n.toLowerCase().replace(/[^a-zа-яё0-9]+/gi, '-').replace(/^-|-$/g, '');
const tires = db.brands.filter(b => b.type === 'tire');
const disks = db.brands.filter(b => b.type === 'disk');
---
<!doctype html><html lang="ru"><head><script is:inline src="/theme-head.js"></script><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title><meta name="description" content={desc} /><link rel="canonical" href={SITE + '/brendy'} />
<meta property="og:title" content={title} /><meta property="og:description" content={desc} /><meta property="og:type" content="website" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="stylesheet" href="/_s555.css?v=5"><script type="application/ld+json" set:html={crumbs}></script>
<!-- Yandex.Metrika counter -->
<script type="text/javascript">
    (function(m,e,t,r,i,k,a){
        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
    })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=112400622', 'ym');
    ym(112400622, 'init', {ssr:true, webvisor:true, clickmap:true, referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
</script>
<noscript><div><img src="https://mc.yandex.ru/watch/112400622" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
<!-- /Yandex.Metrika counter -->
<script is:inline src="/theme.js" defer></script></head>
<body><div class="bg-field" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
<header class="site"><div class="wrap"><nav><a class="brand" href="/" aria-label="шиноподбор — на главную"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="16" cy="16" r="5.5" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="16" cy="16" r="1.6" fill="var(--accent)"/></svg><span>шиноподбор<small>.ru</small></span></a><button class="burger" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="Меню"><svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path class="l1" d="M2 5h16"/><path class="l2" d="M2 10h16"/><path class="l3" d="M2 15h16"/></svg></button><div class="nav-links" id="navlinks"><a href="/">Калькулятор</a><a href="/tablitsa-razmerov">Таблица</a><a href="/markirovka">Маркировка</a><a href="/davlenie">Давление</a><a href="/diski">Диски</a><a href="/sezon">Сезон</a><a href="/primery">Примеры</a><button id="ttheme" class="tbtn" type="button" aria-label="Тёмная тема" title="Тёмная тема">◐</button></div></nav></div></header>
<main class="wrap"><nav class="crumbs" aria-label="Хлебные крошки"><a href="/">Главная</a> / <span aria-current="page">Бренды</span></nav>
<h1>Производители шин и дисков</h1>
<div class="answer"><b>28 брендов:</b> история, линейки и отзывы владельцев. Нажмите на бренд — откроется его страница.</div>
<h2>Шины ({tires.length})</h2>
<div class="cards">
{tires.map(b => (<a class="card" href={'/brendy/' + slug(b.name)}><h3>{b.name}</h3><p>{b.country} · с {b.founded} · {b.segment}</p></a>))}
</div>
<h2>Диски ({disks.length})</h2>
<div class="cards">
{disks.map(b => (<a class="card" href={'/brendy/' + slug(b.name)}><h3>{b.name}</h3><p>{b.country} · с {b.founded} · {b.segment}</p></a>))}
</div>
<p><a href="/">← к калькулятору</a></p></main>
<footer class="site"><div class="wrap"><div class="fgrid"><div><h3>shinapodbor.ru</h3><p>Шинный калькулятор и справочник. Размеры ходовых комплектаций — сверяйтесь с руководством. Обновлено 2026-09-09.</p></div><div><h3>Расчёты</h3><ul><li><a href="/">Калькулятор шин</a></li><li><a href="/tablitsa-razmerov">Таблица размеров</a></li><li><a href="/diski">Проверка дисков</a></li></ul></div><div><h3>Справочник</h3><ul><li><a href="/markirovka">Маркировка</a></li><li><a href="/davlenie">Давление</a></li><li><a href="/sezon">Сезон</a></li><li><a href="/brendy">Бренды</a></li></ul></div></div></div></footer>
</body></html>
