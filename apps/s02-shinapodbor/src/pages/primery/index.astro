const desc = 'Живые примеры: Creta 16→17, Веста 15→16, Haval Jolion, занижение профиля. Диаметр, клиренс, спидометр до и после.';
const faqs = [
  { q: 'Стоит ли переходить с 16 на 17?', a: 'Вид и управляемость лучше, комфорт и цена шин — хуже. Держите диаметр в ±3% и готовьтесь к более жёсткой езде.' },
  { q: 'Что даёт более широкая шина?', a: 'Пятно контакта и стабильность, но +расход, +колея, +аквапланирование. Шире 20 мм от штатной — проверять арки.' },
  { q: 'Занижение профиля — это опасно?', a: 'Само по себе нет, если диаметр в допуске. Но низкий профиль легче пробить до диска на яме.' },
];
