---
import db from '../../../../packages/datasets/tires-db.json';
const SITE = 'https://shinapodbor.ru';
const title = 'Подбор шин и дисков по марке авто — калькулятор размеров | shinapodbor.ru';
const desc = 'Шинный калькулятор: сравнение размеров шин, погрешность спидометра, клиренс. База штатных размеров 114 моделей + топ китайских. Давление, маркировка, вылет дисков.';
const faqs = [
  { q: 'Что означает маркировка 205/55R16?', a: '205 — ширина в мм, 55 — высота профиля в % от ширины, R — радиальная конструкция, 16 — посадочный диаметр в дюймах.' },
  { q: 'Насколько можно отклониться от штатного размера?', a: 'Безопасно — до ±3% по внешнему диаметру. 3–5% — с оговорками (арки, гарантия). Больше 5% — нельзя: врёт спидометр, страдают подвеска и тормоза.' },
  { q: 'Как размер влияет на спидометр?', a: 'Шина большего диаметра проходит больше за оборот: спидометр занижает скорость. При +3% диаметра на 100 км/ч прибор покажет ~97.' },
  { q: 'Какое давление качать?', a: 'По табличке на авто (стойка двери, лючок бака): обычно 2.2–2.5 атм. Под загрузку и трассу +0.2 атм.' },
  { q: 'Можно ли ставить разную резину?', a: 'На одной оси — нет: одинаковые размер, модель и износ. Разные оси допустимы, но нежелательно зимой.' },
  { q: 'Шипы или липучка?', a: 'Лёд и укатанный снег — шипы. Чистый асфальт и мягкая зима — фрикционная (липучка) тише и комфортнее.' },
  { q: 'Что такое вылет диска ET?', a: 'Расстояние от привалочной плоскости до центра диска в мм. Отклонение от штатного более чем на 5–7 мм меняет нагрузку на подшипники.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const siteJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'shinapodbor.ru', url: SITE, inLanguage: 'ru' });
const pageJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE + '/', inLanguage: 'ru', dateModified: '2026-09-08', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#tldr'] } });
const howtoJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'HowTo', name: 'Как подобрать шины и диски', inLanguage: 'ru', step: [{ '@type': 'HowToStep', name: 'Найдите штатное', text: 'Выберите марку и модель — подставим заводской размер.' }, { '@type': 'HowToStep', name: 'Введите кандидата', text: 'Размер, который хотите поставить.' }, { '@type': 'HowToStep', name: 'Проверьте вердикт', text: 'Диаметр в допуске ±3%, диски по PCD/ET/DIA.' }] });
const makes = [...new Set(db.cars.map(c => c.make))].sort();
---
