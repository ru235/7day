---
const SITE = 'https://shinapodbor.ru';
const title = 'Статьи о шинах и дисках | shinapodbor.ru';
const desc = 'Практические статьи: шипы и липучка, хранение, б/у шины, аквапланирование, ошибки диаметра, обкатка.';
const crumbs = JSON.stringify({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Главная', item: SITE + '/' }, { '@type': 'ListItem', position: 2, name: 'Статьи', item: SITE + '/stati' }] });
const arts = [
  { s: 'shipy-lipuchka', h: 'Шипы или липучка', p: 'Лёд и трасса — шипы, город и мягкая зима — липучка.' },
  { s: 'hranenie', h: 'Хранение шин', p: 'На дисках — стопкой, без дисков — стоя. Прохлада и темнота.' },
  { s: 'oshibki-diametra', h: '5 ошибок диаметра', p: 'Диаметр, ширина, вылет, нагрузка, давление.' },
  { s: 'bu-shiny', h: 'Б/у шины', p: 'Возраст, остаток, грыжи, комплектность.' },
  { s: 'akvaplanirovanie', h: 'Аквапланирование', p: 'Ширина, протектор и скорость всплытия.' },
  { s: 'obkatka', h: 'Обкатка новых шин', p: '500 спокойных км, затем протяжка.' },
];
---
