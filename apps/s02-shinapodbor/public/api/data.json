rossContact (кросс)"],"name":"Continental","reviews":[{"cons":"Быстрый износ мягких составов","pros":"Торможение и управляемость — эталон"},{"cons":"Цена премиум","pros":"VikingContact тих и цепок"}],"segment":"премиум","type":"tire"},{"country":"США","founded":1898,"history":"Goodyear — американская легенда, названа в честь изобретателя вулканизации. Поставщик шин для авиации и гонок NASCAR. В России известны линейки EfficientGrip и UltraGrip.","models":["EfficientGrip","Eagle (спорт)","UltraGrip (зима)","Wrangler (внедорожные)"],"name":"Goodyear","reviews":[{"cons":"Средняя износостойкость","pros":"Комфорт и тишина на трассе"},{"cons":"Не самая низкая цена","pros":"UltraGrip предсказуем на каше"}],"segment":"средний / премиум","type":"tire"},{"country":"Италия","founded":1872,"history":"Pirelli — итальянский бренд, синоним спортивных шин и Формулы-1 (монопоставщик с 2011 года). P Zero — штатная резина многих спорткаров. Зимняя линейка Ice Zero.","models":["P Zero","Cinturato","Ice Zero (шипы)","Scorpion (кросс)"],"name":"Pirelli","reviews":[{"cons":"Цена, быстрый износ спорта","pros":"Управляемость на сухом — восторг"},{"cons":"Жёсткие","pros":"Scorpion хорош для кроссоверов"}],"segment":"премиум","type":"tire"},{"country":"Япония","founded":1917,"history":"Yokohama — японский производитель, силён в спортивных и внедорожных шинах. Линейка Advan для трека, Geolandar для SUV. Хорошее соотношение цены и держака.","models":["Advan (спорт)","BluEarth (эко)","Geolandar (SUV)","iceGuard (зима)"],"name":"Yokohama","reviews":[{"cons":"Шум отдельных моделей","pros":"Держак за свои деньги отличный"},{"cons":"Мягкая боковина у туринга","pros":"Geolandar живуч на гравии"}],"segment":"средний","type":"tire"},{"country":"Корея","founded":1941,"history":"Hankook — крупнейший корейский производитель, штатная комплектация многих европейских и корейских авто. Линейки Ventus (спорт/туринг) и Winter i*cept (зима).","models":["Ventus Prime","Kinergy (туринг)","Winter i*cept (зима)","Dynapro (SUV)"],"name":"Hankook","reviews":[{"cons":"Средний держак на льду у фрикционок","pros":"Цена/качество — одно из лучших"},{"cons":"Шум на грубом асфальте","pros":"Dynapro крепок для кроссоверов"}],"segment":"средний","type":"tire"},{"country":"Корея","founded":1960,"history":"Kumho — второй корейский гигант. Известен смелым дизайном и линейкой Ecsta для спорта. Хороший выбор в среднем бюджете, штатно ставится на многие Kia/Hyundai.","models":["Ecsta (спорт)","Solus (туринг)","WinterCraft (зима)","Road Venture (SUV)"],"name":"Kumho","reviews":[{"cons":"Износ быстрее премиума","pros":"Цена заметно ниже, держак честный"},{"cons":"Плывёт в жару","pros":"Solus тихий и комфортный"}],"segment":"бюджет / средний","type":"tire"},{"country":"Япония","founded":1945,"history":"Toyo — японский бренд с культом у любителей тюнинга (Proxes) и внедорожников (Open Country). Мягкие комфортные составы, честная цена.","models":["Proxes (спорт/туринг)","Open Country (SUV)","Observe (зима)","NanoEnergy (эко)"],"name":"Toyo","reviews":[{"cons":"Быстрый износ мягких линеек","pros":"Комфорт и тишина"},{"cons":"Не для трека","pros":"Open Country держит гравий и грязь"}],"segment":"средний","type":"tire"},{"country":"Швеция","founded":1893,"history":"Gislaved — шведская марка с северными корнями, сейчас в составе Continental. Специализация — зимние шины для сурового климата по разумной цене.","models":["Nord Frost (шипы)","Soft Frost (фрикция)"],"name":"Gislaved","reviews":[{"cons":"Прошлогодние модели шумноваты","pros":"Зима за вменяемые деньги"},{"cons":"Летних почти нет","pros":"Nord Frost стабилен на снегу"}],"segment":"средний","type":"tire"},{"country":"Россия","founded":2012,"history":"Cordiant — российский бренд (бывший актив СИБУРа). Заводы в Ярославле и Омске. Линейки Comfort, Sport, Snow Cross (шипы) и Business для коммерческого транспорта.","models":["Comfort 2","Sport 3","Snow Cross (шипы)","Business CA (газели)"],"name":"Cordiant","reviews":[{"cons":"Шум, средний баланс","pros":"Дёшево и доступно везде"},{"cons":"Плывёт в жару","pros":"Snow Cross — народные шипы"}],"segment":"бюджет","type":"tire"},{"country":"Россия","founded":1973,"history":"KAMA — бренд Нижнекамского шинного завода (Татарстан), одного из крупнейших в России. Viatti — легковая линейка завода. Рабочие лошадки для наших дорог.","models":["KAMA Euro","Viatti Strada","Viatti Brina (зима)","KAMA Flame (Нива/УАЗ)"],"name":"KAMA / Viatti","reviews":[{"cons":"Шум и вес","pros":"Крепкие, дешёвые, везде есть"},{"cons":"Средний держак на мокром","pros":"Flame — классика для Нивы"}],"segment":"бюджет","type":"tire"},{"country":"Китай","founded":1976,"history":"Triangle — один из старейших китайских производителей, поставляет шины для грузовиков и спецтехники по всему миру. Легковые линейки — бюджетный выбор.","models":["AdvanteX (туринг)","SeasonX (всесезонка)","SnowLink (зима)"],"name":"Triangle","reviews":[{"cons":"Средний держак на мокром","pros":"Очень дёшево, для спокойной езды хватает"},{"cons":"Шум","pros":"Крепкая боковина"}],"segment":"бюджет","type":"tire"},{"country":"Китай","founded":2002,"history":"Sailun — китайский бренд, вкладывающийся в тесты и европейские полигоны. Линейки Atrezzo (туринг) и Ice Blazer (зима) регулярно удивляют в сравнительных тестах.","models":["Atrezzo","Terramax (SUV)","Ice Blazer (зима)"],"name":"Sailun","reviews":[{"cons":"Лотерея по партиям","pros":"Лучший Китай по тестам за свои деньги"},{"cons":"Износ выше среднего","pros":"Ice Blazer достойно держит снег"}],"segment":"бюджет","type":"tire"},{"country":"Китай","founded":1975,"history":"Linglong — китайский гигант, поставщик конвейеров (включая европейские заводы). В России известен доступными линейками Comfort и CrossWind для кроссоверов.","models":["Comfort Master","CrossWind (SUV)","Green-Max Winter"],"name":"Linglong","reviews":[{"cons":"Средние характеристики","pros":"Цена минимальная среди приличных"},{"cons":"Плывёт в жару","pros":"Для дачной езды хватает"}],"segment":"бюджет","