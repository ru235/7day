<script>
gz.onclick=()=>{const r=+rho.value,L=+len.value,N=+need.value;
const R1=r/(2*Math.PI*L)*Math.log(4*L/0.05);
let n=1;while((R1/n/0.7)>N&&n<12)n++;
gout.innerHTML=`Один электрод: <b>${R1.toFixed(1)} Ом</b> · Контур: <b>${n} шт</b> → ≈ ${(R1/n/0.7).toFixed(1)} Ом (треугольник/ряд с к=0.7)`;
try{window.s555ev&&s555ev('calc_run',{page:'zazemlenie'})}catch(e){}};
</script>
