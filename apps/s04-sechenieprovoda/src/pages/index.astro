---
const SITE = 'https://sechenieprovoda.ru';
const title = 'Подбор сечения кабеля и автомата — калькулятор по мощности | sechenieprovoda.ru';
const desc = 'Калькулятор сечения кабеля по мощности и току: медь/алюминий, 220В/380В/12В, длина и падение напряжения. Подбор автомата по ПУЭ. Таблицы, FAQ, печать.';
const faqs = [
  { q: 'Какое сечение нужно на 5 кВт в 220В?', a: 'Ток ≈ 22.7А. Медь скрытая — 4 мм² (38А) + автомат 25А. 2.5 мм² (27А) — на пределе, не рекомендуется.' },
  { q: 'Какой автомат ставить на 2.5 мм² меди?', a: 'Не более 25А (лучше 20А для розеток), т.к. длительный ток 2.5 мм² — 27А.' },
  { q: 'Как учесть длину кабеля?', a: 'Считаем падение напряжения: dU=2·I·L·ρ/S. Для 220В держите падение <3–5%. При длине >30м сечение обычно +1 шаг.' },
  { q: 'Почему автомат выбирают по кабелю, а не по приборам?', a: 'Автомат защищает проводку от перегрева, а не чайник. Если кабель 2.5 мм² держит 27А, автомат ставят 20–25А: при перегрузке он отключится раньше, чем поплавится изоляция.' },
  { q: 'Что будет, если взять сечение с запасом в 2 раза?', a: 'Ничего страшного, кроме цены и толстого кабеля, который тяжело гнуть. Запас +1 шаг — разумно, +3 шага — переплата.' },
  { q: 'Чем медь лучше алюминия?', a: 'Медь гнётся и не окисляется, держит больший ток при том же сечении. Алюминий дешевле и легче — для ввода СИП и больших сечений. В квартиру по ПУЭ — только медь.' },
  { q: 'Нужен ли отдельный автомат на духовку и стиралку?', a: 'Да. Мощные приборы (от 2 кВт) сажают на отдельные линии со своим автоматом: духовка 3.5 кВт — 3×2.5 + 16А. Иначе общий автомат будет выбивать при одновременной работе.' },
];
const faqJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) });
const siteJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'sechenieprovoda.ru', url: SITE, inLanguage: 'ru' });
const pageJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebPage', name: title, url: SITE + '/', inLanguage: 'ru', dateModified: '2026-09-06', speakable: { '@type': 'SpeakableSpecification', cssSelector: ['#tldr'] } });
const howtoJson = JSON.stringify({ '@context': 'https://schema.org', '@type': 'HowTo', name: 'Как подобрать сечение кабеля и автомат', inLanguage: 'ru', step: [{ '@type': 'HowToStep', name: 'Посчитайте ток', text: 'I = P / U: мощность в ваттах разделите на напряжение.' }, { '@type': 'HowToStep', name: 'Возьмите сечение с запасом', text: 'По таблице ПУЭ ближайшее большее под ток с запасом 25%.' }, { '@type': 'HowToStep', name: 'Выберите автомат', text: 'Ближайший номинал выше тока, но не выше длит. тока кабеля.' }] });
---
<!doctype html>
<html lang="ru">
<head><script is:inline src="/theme-head.js"></script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={SITE + '/'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={desc} />
<meta property="og:type" content="website" />
<link rel="alternate" type="application/json" title="Данные сайта для ИИ" href="/api/data.json" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="stylesheet" href="/_s555.css" />
<script type="application/ld+json" set:html={faqJson}></script>
<script type="application/ld+json" set:html={siteJson}></script>
<script type="application/ld+json" set:html={pageJson}></script>
<script type="application/ld+json" set:html={howtoJson}></script>
<script is:inline src="/theme.js" defer></script></head>
<body><div class="bg-field" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
<header class="site"><div class="wrap"><nav><a class="brand" href="/" aria-label="сечениепровода — на главную"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="13.5" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="11.5" cy="13.5" r="3.4" fill="currentColor"/><circle cx="20.5" cy="13.5" r="3.4" fill="currentColor"/><circle cx="16" cy="20.5" r="3.4" fill="var(--accent)"/></svg><span>сечениепровода<small>.ru</small></span></a><button class="burger" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="Меню"><span></span><span></span></button><div class="nav-links" id="navlinks"><a href="/" aria-current="page">Калькулятор</a><a href="/sechenie-tok-tablica">Таблица</a><a href="/avtomat-vybor">Автомат</a><a href="/kabel-markirovka">Маркировка</a><a href="/zazemlenie">Заземление</a><a href="/teoriya-formuly">Теория</a><a href="/primery-raschetov">Примеры</a><button id="ttheme" class="tbtn" type="button" aria-label="Тёмная тема" title="Тёмная тема">◐</button></div></nav></div></header>
<main class="wrap">
<section class="hero">
<p class="eyebrow">Калькулятор электрика</p>
<h1>Сечение кабеля и автомат по мощности</h1>
<p>Медь и алюминий · 220, 380 и 12 В · длина линии и падение напряжения. Считает по ПУЭ с запасом 25%, результат можно распечатать.</p>
</section>
<div class="answer" id="tldr"><b>Короткий ответ:</b> ток I = P / U. Для 5 кВт в 220 В → 22.7 А → медь 4 мм² + автомат 25А. Для 3.5 кВт → 15.9 А → медь 2.5 мм² + автомат 16А. Длину свыше 30 м — сечение +1 шаг.</div>
<section class="calc" id="calc" aria-label="Калькулятор сечения кабеля">
<div class="calc-layout">
<div class="calc-fields">
<label>Мощность, Вт <input id="p" type="number" value="5000" min="50" max="100000" /></label>
<label>Напряжение <select id="u"><option value="220">220 В (дом)</option><option value="380">380 В (3 фазы)</option><option value="12">12 В (авто)</option></select></label>
<label>Материал <select id="m"><option value="cu">Медь</option><option value="al">Алюминий</option></select></label>
<label>Длина линии, м <input id="l" type="number" value="20" min="1" max="500" /></label>
<div><button class="btn" id="go">Рассчитать</button>
<button class="btn ghost" id="print">Печать</button></div>
</div>
<aside class="calc-side" aria-live="polite">
<span class="result-label">Результат</span>
<div class="result" id="out">—</div>
<p style="font-size:13px;color:var(--muted)">История сохраняется локально. <button class="btn ghost" id="share">Скопировать ссылку</button></p>
</aside>
</div>
</section>
<h2>Таблица: медь скрытая (ПУЭ)</h2>
<table class="data"><caption>Длительный ток и номинал автомата. Полная версия — на странице таблицы.</caption><tr><th>Сечение, мм²</th><th>Ток, А</th><th>Мощность 220В, кВт</th><th>Автомат</th></tr>
<tr><td>1.5</td><td>19</td><td>4.1</td><td>16А</td></tr>
<tr><td>2.5</td><td>27</td><td>5.9</td><td>20–25А</td></tr>
<tr><td>4</td><td>38</td><td>8.3</td><td>25–32А</td></tr>
<tr><td>6</td><td>50</td><td>11</td><td>40А</td></tr>
<tr><td>10</td><td>70</td><td>15.4</td><td>50–63А</td></tr>
<tr><td>16</td><td>80</td><td>17.6</td><td>63–80А</td></tr></table>
<p><a href="/sechenie-tok-tablica">Полная таблица до 95 мм² →</a></p>
<h2>Как пользоваться</h2>
<ol><li>Введите мощность и напряжение.</li><li>Укажите длину — учтём падение.</li><li>Возьмите результат в магазин / распечатайте.</li></ol>
<h2>Схема квартирного щита</h2>
<svg viewBox="0 0 560 210" width="100%" role="img" aria-label="Схема щита: ввод, счётчик, автоматы линий" style="background:var(--card);border:1px solid var(--line);border-radius:10px">
<rect x="20" y="70" width="90" height="70" rx="8" fill="none" stroke="var(--brand)" stroke-width="2"/><text x="65" y="100" text-anchor="middle" font-size="12">Ввод</text><text x="65" y="118" text-anchor="middle" font-size="12">32А</text>
<rect x="130" y="70" width="90" height="70" rx="8" fill="none" stroke="var(--muted)" stroke-width="2"/><text x="175" y="100" text-anchor="middle" font-size="12">Счётчик</text>
<rect x="250" y="20" width="90" height="50" rx="8" fill="none" stroke="var(--accent)" stroke-width="2"/><text x="295" y="40" text-anchor="middle" font-size="12">Свет 10А</text><text x="295" y="56" text-anchor="middle" font-size="11" fill="var(--muted)">3×1.5</text>
<rect x="250" y="80" width="90" height="50" rx="8" fill="none" stroke="var(--accent)" stroke-width="2"/><text x="295" y="100" text-anchor="middle" font-size="12">Розетки 16А</text><text x="295" y="116" text-anchor="middle" font-size="11" fill="var(--muted)">3×2.5</text>
<rect x="250" y="140" width="90" height="50" rx="8" fill="none" stroke="var(--accent)" stroke-width="2"/><text x="295" y="160" text-anchor="middle" font-size="12">Духовка 16А</text><text x="295" y="176" text-anchor="middle" font-size="11" fill="var(--muted)">3×2.5 отд.</text>
<line x1="110" y1="105" x2="130" y2="105" stroke="var(--muted)" stroke-width="2"/><line x1="220" y1="105" x2="250" y2="45" stroke="var(--muted)" stroke-width="2"/><line x1="220" y1="105" x2="250" y2="105" stroke="var(--muted)" stroke-width="2"/><line x1="220" y1="105" x2="250" y2="165" stroke="var(--muted)" stroke-width="2"/>
<text x="380" y="60" font-size="13">каждая мощная линия —</text><text x="380" y="80" font-size="13">свой автомат и кабель</text><text x="380" y="110" font-size="13" fill="var(--muted)">УЗО 30 мА — на розетки</text><text x="380" y="130" font-size="13" fill="var(--muted)">и влажные зоны</text>
</svg>
<h2>Справочник</h2>
<div class="cards">
<a class="card" href="/sechenie-tok-tablica"><h3>Таблица сечение–ток</h3><p>Полные данные до 95 мм²: медь и алюминий, мощность, автоматы.</p></a>
<a class="card" href="/avtomat-vybor"><h3>Выбор автомата</h3><p>Номинал по кабелю, характеристики B, C, D, селективность.</p></a>
<a class="card" href="/kabel-markirovka"><h3>Маркировка кабелей</h3><p>ВВГ, NYM, ПВС, СИП: расшифровка и куда какой.</p></a>
<a class="card" href="/zazemlenie"><h3>Заземление</h3><p>Контур треугольником, нормы и калькулятор электродов.</p></a>
<a class="card" href="/teoriya-formuly"><h3>Теория и формулы</h3><p>Три формулы обычным языком: ток, нагрев, падение.</p></a>
<a class="card" href="/primery-raschetov"><h3>Примеры расчётов</h3><p>Студия, дом 15 кВт, гараж 12 В, баня в 60 метрах.</p></a>
</div>
<h2>Частые вопросы</h2>
<div class="faq">{faqs.map(f => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
</main>
<footer class="site"><div class="wrap"><div class="fgrid"><div><h3>sechenieprovoda.ru</h3><p>Калькуляторы и справочник электрика. Расчёт ориентировочный, сверяйтесь с ПУЭ и электриком. Обновлено 2026-09-06.</p></div><div><h3>Расчёты</h3><ul><li><a href="/">Калькулятор сечения</a></li><li><a href="/sechenie-tok-tablica">Таблица сечение–ток</a></li><li><a href="/zazemlenie">Заземление</a></li></ul></div><div><h3>Справочник</h3><ul><li><a href="/avtomat-vybor">Выбор автомата</a></li><li><a href="/kabel-markirovka">Маркировка кабелей</a></li><li><a href="/teoriya-formuly">Теория и формулы</a></li><li><a href="/primery-raschetov">Примеры расчётов</a></li></ul></div></div></div></footer>

<style>@import url('/_s555.css');</style>
<script>
const RHO={cu:0.0175,al:0.028};
const TAB={cu:[[1.5,19],[2.5,27],[4,38],[6,50],[10,70],[16,80],[25,105],[35,130],[50,160],[70,200],[95,250]],al:[[2.5,20],[4,28],[6,36],[10,50],[16,60],[25,80],[35,95],[50,120],[70,150],[95,190]]};
const BR=[6,10,16,20,25,32,40,50,63,80,100,125,160,200,250];
const MAXI={cu:250,al:190};
function calc(){const P=+p.value,U=+u.value,M=m.value,L=+l.value;
const I=U===380?P/(1.732*380*0.95):P/U;
if(!(I>0)){out.textContent='Введите мощность больше нуля.';return}
const row=TAB[M].find(r=>r[1]>=I*1.25);
if(!row){out.innerHTML=`Ток: <b>${I.toFixed(1)} А</b> — вне бытового диапазона (таблица до ${MAXI[M]} А).<br>Такая нагрузка требует проекта: параллельные линии, шины, согласование с сетями. Обратитесь к электрику.`;return}
const S=row[0],Imax=row[1];
let br=BR.find(b=>b>=I);if(br>Imax)br=BR.filter(b=>b<=Imax).pop();
const dU=U===380?(1.732*I*L*RHO[M]/S):(2*I*L*RHO[M]/S),pct=dU/U*100;
const big=S>=25?' · <b>нужен проект</b> (сечения от 25 мм² — не бытовой монтаж)':'';
out.innerHTML=`Ток: <b>${I.toFixed(1)} А</b> · Сечение: <b>${S} мм² (${M==='cu'?'медь':'алюминий'})</b> · Автомат: <b>${br}А</b>${big}<br>Падение: ${dU.toFixed(1)} В (${pct.toFixed(1)}%) ${pct>5?'— увеличьте сечение':''}`;
try{const h=JSON.parse(localStorage.getItem('s04')||'[]');h.unshift({P,U,M,L,t:Date.now()});localStorage.setItem('s04',JSON.stringify(h.slice(0,20)))}catch(e){}
try{window.s555ev&&s555ev('calc_run',{P,U})}catch(e){}}
go.onclick=calc;print.onclick=()=>window.print();
share.onclick=async()=>{const s=location.href;try{await navigator.clipboard.writeText(s);share.textContent='Скопировано'}catch(e){}};
(function(){const q=new URLSearchParams(location.search);if(q.get('p'))p.value=q.get('p');calc()})();
</script>
</body>
</html>
